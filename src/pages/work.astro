---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import GetStartedModal from '../components/GetStartedModal.astro';
import workVideos from '../data/work-videos.json';

// Videos are served from Cloudflare R2 in production (PUBLIC_MEDIA_BASE).
const MEDIA_BASE = import.meta.env.PUBLIC_MEDIA_BASE ?? '';

type Medium = 'photo' | 'video' | 'social';
type Item = {
  src: string; type: Medium; ind: string; title: string;
  desc?: string; noExpand?: boolean;
  poster?: string; aspect?: string; wide?: boolean;
};

const industries = [
  { id: 'real-estate',   label: 'Real estate' },
  { id: 'food-beverage', label: 'Food & Beverage' },
  { id: 'schools',       label: 'Schools' },
  { id: 'hospitality',   label: 'Hospitality' },
  { id: 'automotive',    label: 'Automotive' },
  { id: 'products',      label: 'Products' },
  { id: 'corporate',     label: 'Corporate' },
  { id: 'events',        label: 'Events' },
];
const indLabel = Object.fromEntries(industries.map(i => [i.id, i.label]));
const media = [
  { id: 'all',    label: 'All Work' },
  { id: 'photo',  label: 'Photography' },
  { id: 'video',  label: 'Videography' },
  { id: 'social', label: 'Social Media' },
];
const medLabel: Record<Medium, string> = { photo: 'Photography', video: 'Videography', social: 'Social Media' };

const range = (n: number) => Array.from({ length: n }, (_, i) => i + 1);
const photoSet = (dir: string, slots: number[], ind: string, titles?: string[], noExpand = false, wideSlides: number[] = []): Item[] =>
  slots.flatMap((count, s) => range(count).map(k => ({
    src: `/images/work/photography/${dir}slide${s + 1}/${k}.jpg`, type: 'photo' as const, ind,
    title: titles?.[s] ?? indLabel[ind], noExpand,
    wide: wideSlides.includes(s + 1),
  })));

const social = [
  { id: 'mahrouseh', title: 'Mahrouseh', desc: "Mahrouseh is a Syrian restaurant based in Sharjah, UAE. We've been managing its social media presence for over two years, creating content that reflects the authenticity of Syrian cuisine while building a strong and engaging online community. Through a consistent content strategy and creative storytelling, we've helped strengthen the brand's digital presence and connect with a wider audience." },
  { id: 'mandi',     title: 'Mandi Street', desc: "Mandi Street brings traditional Yemeni mandi to a modern audience. We craft its social content across campaigns and everyday posts — from bold promo creatives to appetite-driving lifestyle imagery — building a distinctive voice that keeps the brand top-of-mind." },
];

// Videos hosted on R2 under videos/work/<industry>/N.mp4 (+ N.jpg poster).
// src/data/work-videos.json carries each clip's real pixel dimensions so
// portraits and landscapes render at their true aspect.
const videoSet = (ind: string): Item[] => {
  const list = (workVideos as Record<string, { n: number; w: number; h: number }[]>)[ind] ?? [];
  return list.map(v => ({
    src:    `${MEDIA_BASE}/videos/work/${ind}/${v.n}.mp4`,
    poster: `${MEDIA_BASE}/videos/work/${ind}/${v.n}.jpg`,
    aspect: `${v.w} / ${v.h}`,
    type:   'video' as const,
    ind,
    title:  indLabel[ind],
  }));
};

// Groups are interleaved round-robin so "All Work" reads as a varied wall.
const groups: Item[][] = [
  photoSet('', [11, 11, 11, 11], 'food-beverage'),
  photoSet('automotive/', [9, 12, 13], 'automotive', ['Corvette', 'Porsche GT3', 'KTM Off-road']),
  videoSet('automotive'),
  videoSet('corporate'),
  videoSet('events'),
  videoSet('food-beverage'),
  videoSet('hospitality'),
  videoSet('real-estate'),
  videoSet('schools'),
  range(8).map(n => ({ src: `${MEDIA_BASE}/images/work/video/${n}.mp4`, type: 'video' as const, ind: 'food-beverage', title: 'Food & Beverage' })),
  photoSet('real-estate/', [11, 11, 11, 11], 'real-estate'),
  social.flatMap(c => range(16).map(n => ({ src: `/images/work/social/${c.id}/${n}.jpg`, type: 'social' as const, ind: 'food-beverage', title: c.title, desc: c.desc }))),
  photoSet('hospitality/', [11, 7], 'hospitality'),
  photoSet('products/', [11, 11, 11], 'products'),
  [
    ...photoSet('schools/', [11, 9], 'schools', ['Graduation', 'Graduation'], true),
    // slide4 (framed) sits above the wide panoramics in the regular
    // masonry — same tile size as every other schools photo.
    ...range(3).map(k => ({ src: `/images/work/photography/schools/slide4/${k}.jpg`, type: 'photo' as const, ind: 'schools', title: 'Graduation', noExpand: true })),
    // slide3 (panoramic group shots) are the only wide/feature tiles.
    ...range(3).map(k => ({ src: `/images/work/photography/schools/slide3/${k}.jpg`, type: 'photo' as const, ind: 'schools', title: 'Graduation', noExpand: true, wide: true })),
  ],
];
const items: Item[] = [];
for (let i = 0; groups.some(g => i < g.length); i++) for (const g of groups) if (i < g.length) items.push(g[i]);
---
<BaseLayout title="Work — Ora Digital Media">
  <div class="work-page-bg" aria-hidden="true"></div>
  <Nav />

  <!-- ═══════════ HERO REEL (full-bleed) ═══════════ -->
  <section class="w-hero">
    <video class="w-hero-video" src={`${MEDIA_BASE}/videos/work-hero.mp4`} autoplay muted loop playsinline preload="auto" data-hero-video></video>
    <div class="w-hero-shade" aria-hidden="true"></div>
    <h1 class="w-hero-title">Work</h1>
    <button type="button" class="w-round-btn w-hero-mute" data-hero-mute aria-label="Unmute video" aria-pressed="true">
      <svg class="icon-muted" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/><path d="M16 9l5 6M21 9l-5 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/></svg>
      <svg class="icon-unmuted" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/><path d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/></svg>
    </button>
  </section>

  <!-- ═══════════ FILTERS ═══════════ -->
  <div class="w-filters container">
    <div class="w-tabs w-scroll" role="tablist" aria-label="Medium">
      {media.map((m, i) => (
        <button type="button" role="tab" class={`w-tab ${i === 0 ? 'is-active' : ''}`} data-med={m.id} aria-selected={i === 0 ? 'true' : 'false'}>
          {m.label}<span class="w-tab-hint">Food &amp; Beverage only</span>
        </button>
      ))}
    </div>
    <div class="w-chiprow">
      <div class="w-chips w-scroll" aria-label="Industry">
        <button type="button" class="w-chip is-active" data-ind="all" aria-pressed="true">All</button>
        {industries.map(it => (
          <button type="button" class="w-chip" data-ind={it.id} aria-pressed="false">{it.label}</button>
        ))}
      </div>
      <span class="w-count" data-count></span>
    </div>
  </div>

  <!-- ═══════════ MASONRY ═══════════ -->
  <section class="w-gallery container">
    <div class="w-masonry" data-masonry>
      {items.map((it, i) => (
        <figure
          class={`g-tile ${it.noExpand ? 'no-expand' : ''} ${it.wide ? 'is-wide' : ''}`}
          data-type={it.type}
          data-ind={it.ind}
          data-title={it.title}
          data-cat={`${indLabel[it.ind]} · ${medLabel[it.type]}`}
          data-desc={it.desc ?? ''}
          data-src={it.src}
          data-aspect={it.aspect}
          tabindex={it.noExpand ? undefined : 0}
          role={it.noExpand ? undefined : 'button'}
          aria-label={it.noExpand ? undefined : `Open ${it.title}`}
        >
          <div class="g-media" style={it.aspect ? `aspect-ratio: ${it.aspect};` : undefined}>
            {it.type === 'video' ? (
              <>
                <video
                  src={`${it.src}#t=0.1`}
                  poster={it.poster}
                  muted loop playsinline preload="metadata"
                  onerror="this.closest('.g-tile').dataset.broken=''"
                ></video>
                <span class="g-badge"><svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg>Video</span>
                <span class="g-progress" aria-hidden="true"></span>
              </>
            ) : (
              <img src={it.src} alt={`${it.title} — ${medLabel[it.type]}`} loading={i < 12 ? 'eager' : 'lazy'} decoding="async" draggable="false" onerror="this.closest('.g-tile').dataset.broken=''" />
            )}
            <figcaption class="g-cap g-cap-over">
              <span class="g-title">{it.title}</span>
              <span class="g-cat">{indLabel[it.ind]} · {medLabel[it.type]}</span>
            </figcaption>
          </div>
          <div class="g-cap g-cap-below" aria-hidden="true">
            <span class="g-title">{it.title}</span>
            <span class="g-cat">{indLabel[it.ind]} · {medLabel[it.type]}</span>
          </div>
        </figure>
      ))}
    </div>
  </section>

  <!-- ═══════════ LIGHTBOX ═══════════ -->
  <div class="w-lb" data-lb hidden role="dialog" aria-modal="true" aria-label="Project viewer">
    <div class="w-lb-top">
      <span class="w-lb-pos" data-lb-pos></span>
      <button type="button" class="w-round-btn" data-lb-close aria-label="Close">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </div>
    <div class="w-lb-stage" data-lb-stage>
      <div class="w-lb-media" data-lb-media></div>
    </div>
    <div class="w-lb-info">
      <div class="w-lb-text">
        <p class="w-lb-cat" data-lb-cat></p>
        <p class="w-lb-title" data-lb-title></p>
        <p class="w-lb-desc" data-lb-desc></p>
      </div>
      <div class="w-lb-nav">
        <button type="button" class="w-round-btn" data-lb-prev aria-label="Previous">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="w-round-btn" data-lb-next aria-label="Next">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
  </div>

  <Footer />
  <GetStartedModal />
</BaseLayout>

<script>
  /* ── Filters: medium tabs × industry chips ───────────────────────── */
  const tiles = Array.from(document.querySelectorAll<HTMLElement>('.g-tile'));
  const tabs  = Array.from(document.querySelectorAll<HTMLButtonElement>('.w-tab'));
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.w-chip'));
  const countEl = document.querySelector<HTMLElement>('[data-count]');
  let med = 'all', ind = 'all';

  const matches = (t: HTMLElement, m: string, i: string) =>
    !('broken' in t.dataset) && (m === 'all' || t.dataset.type === m) && (i === 'all' || t.dataset.ind === i);

  const apply = () => {
    let n = 0;
    for (const t of tiles) { const ok = matches(t, med, ind); t.hidden = !ok; if (ok) n++; }
    for (const tab of tabs) {
      const id = tab.dataset.med!;
      const on = id === med;
      tab.classList.toggle('is-active', on);
      tab.setAttribute('aria-selected', String(on));
      tab.classList.toggle('is-unavailable', !tiles.some(t => matches(t, id, ind)));
    }
    for (const c of chips) {
      const id = c.dataset.ind!;
      const on = id === ind;
      c.classList.toggle('is-active', on);
      c.setAttribute('aria-pressed', String(on));
      c.hidden = id !== 'all' && !tiles.some(t => matches(t, med, id));
    }
    if (countEl) countEl.textContent = `${n} ${n === 1 ? 'piece' : 'pieces'}`;
  };

  tabs.forEach(tab => tab.addEventListener('click', () => {
    med = tab.dataset.med!;
    if (!tiles.some(t => matches(t, med, ind))) ind = 'all';   // e.g. Social Media → only F&B has it
    apply();
  }));
  chips.forEach(c => c.addEventListener('click', () => { ind = c.dataset.ind!; apply(); }));
  apply();

  // A tile that fails to load drops out of the grid and the lightbox.
  new MutationObserver(apply).observe(document.querySelector('[data-masonry]')!, { subtree: true, attributes: true, attributeFilter: ['data-broken'] });

  /* ── Video tiles: muted preview on hover (mouse only) ───────────── */
  tiles.filter(t => t.dataset.type === 'video').forEach(t => {
    const v = t.querySelector('video')!;
    t.addEventListener('pointerenter', e => { if (e.pointerType === 'mouse') { v.muted = true; v.play().catch(() => {}); t.classList.add('is-previewing'); } });
    t.addEventListener('pointerleave', () => { v.pause(); v.currentTime = 0.1; t.classList.remove('is-previewing'); });
  });

  /* ── Reveal on scroll ───────────────────────────────────────────── */
  const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
  tiles.forEach(t => io.observe(t));

  /* ── Lightbox ───────────────────────────────────────────────────── */
  const lb      = document.querySelector<HTMLElement>('[data-lb]')!;
  const stage   = document.querySelector<HTMLElement>('[data-lb-stage]')!;
  const mediaEl = document.querySelector<HTMLElement>('[data-lb-media]')!;
  const posEl   = document.querySelector<HTMLElement>('[data-lb-pos]')!;
  const catEl   = document.querySelector<HTMLElement>('[data-lb-cat]')!;
  const titleEl = document.querySelector<HTMLElement>('[data-lb-title]')!;
  const descEl  = document.querySelector<HTMLElement>('[data-lb-desc]')!;
  let list: HTMLElement[] = [];
  let idx = 0;
  let lastFocus: HTMLElement | null = null;

  const pad = (n: number) => String(n).padStart(2, '0');
  const render = () => {
    const t = list[idx]; if (!t) return;
    const src = t.dataset.src!;
    mediaEl.innerHTML = '';
    if (t.dataset.type === 'video') {
      const v = document.createElement('video');
      Object.assign(v, { src, controls: true, autoplay: true, loop: true, playsInline: true });
      // Browser sizes <video> from its natural width/height once metadata
      // loads; no need to force an aspect-ratio that could conflict with
      // the max-height cap and stretch portrait clips sideways.
      mediaEl.appendChild(v);
    } else {
      const img = document.createElement('img');
      img.src = src; img.alt = t.dataset.title || ''; img.draggable = false;
      mediaEl.appendChild(img);
    }
    mediaEl.classList.remove('is-in'); void mediaEl.offsetWidth; mediaEl.classList.add('is-in');
    posEl.textContent = `${pad(idx + 1)} / ${pad(list.length)}`;
    catEl.textContent = t.dataset.cat || '';
    titleEl.textContent = t.dataset.title || '';
    descEl.textContent = t.dataset.desc || '';
    descEl.hidden = !t.dataset.desc;
    // Preload neighbours
    [list[idx + 1], list[idx - 1]].forEach(n => { if (n && n.dataset.type !== 'video') { const i = new Image(); i.src = n.dataset.src!; } });
  };
  const openAt = (t: HTMLElement) => {
    list = tiles.filter(x => !x.hidden && !x.classList.contains('no-expand'));
    idx = Math.max(0, list.indexOf(t));
    lastFocus = document.activeElement as HTMLElement;
    lb.hidden = false;
    document.body.style.overflow = 'hidden';
    render();
    lb.querySelector<HTMLElement>('[data-lb-close]')?.focus();
  };
  const close = () => {
    lb.hidden = true; mediaEl.innerHTML = '';
    document.body.style.overflow = '';
    lastFocus?.focus();
  };
  const step = (d: number) => { if (!list.length) return; idx = (idx + d + list.length) % list.length; render(); };

  tiles.forEach(t => {
    if (t.classList.contains('no-expand')) return;
    t.addEventListener('click', () => openAt(t));
    t.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openAt(t); } });
  });
  lb.querySelector('[data-lb-close]')?.addEventListener('click', close);
  lb.querySelector('[data-lb-prev]')?.addEventListener('click', () => step(-1));
  lb.querySelector('[data-lb-next]')?.addEventListener('click', () => step(1));
  let justDragged = false;
  lb.addEventListener('click', e => {
    if (justDragged) { justDragged = false; return; }
    if (e.target === lb || e.target === stage) close();
  });
  document.addEventListener('keydown', e => {
    if (lb.hidden) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowRight') step(1);
    else if (e.key === 'ArrowLeft') step(-1);
  });

  // Swipe / drag
  let x0 = 0, dx = 0, dragging = false;
  stage.addEventListener('pointerdown', e => {
    if ((e.target as HTMLElement).closest('video')) return;   // keep native video controls usable
    dragging = true; x0 = e.clientX; dx = 0;
    mediaEl.style.transition = 'none';
    stage.setPointerCapture(e.pointerId);
  });
  stage.addEventListener('pointermove', e => {
    if (!dragging) return;
    dx = e.clientX - x0;
    mediaEl.style.transform = `translateX(${dx}px)`;
  });
  const endDrag = () => {
    if (!dragging) return;
    dragging = false;
    mediaEl.style.transition = '';
    mediaEl.style.transform = '';
    justDragged = Math.abs(dx) > 5;
    if (Math.abs(dx) > 60) step(dx < 0 ? 1 : -1);
  };
  stage.addEventListener('pointerup', endDrag);
  stage.addEventListener('pointercancel', endDrag);

  /* ── Hero mute toggle ───────────────────────────────────────────── */
  const heroVideo = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const heroMute  = document.querySelector<HTMLButtonElement>('[data-hero-mute]');
  if (heroVideo && heroMute) {
    const sync = () => {
      heroMute.setAttribute('aria-pressed', String(heroVideo.muted));
      heroMute.setAttribute('aria-label', heroVideo.muted ? 'Unmute video' : 'Mute video');
    };
    heroMute.addEventListener('click', () => {
      heroVideo.muted = !heroVideo.muted;
      if (!heroVideo.muted) heroVideo.play().catch(() => {});
      sync();
    });
    heroVideo.addEventListener('volumechange', sync);
    sync();
  }
</script>

<style>
  /* ── Page tint (sits over BaseLayout's starfield) ───────────────── */
  .work-page-bg {
    position: fixed; inset: 0; z-index: -1; pointer-events: none;
    background: linear-gradient(180deg, rgba(81,69,155,.16), rgba(107,62,136,.10) 30%, rgba(142,74,93,.10) 60%, rgba(176,74,46,.14));
  }

  /* ── Shared round icon button ───────────────────────────────────── */
  .w-round-btn {
    appearance: none; flex: none;
    width: 52px; height: 52px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    color: #fff; cursor: pointer;
    background: rgba(5,3,8,.55);
    border: 1px solid rgba(255,255,255,.28);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    transition: border-color .2s ease, background .2s ease, transform .2s ease;
  }
  .w-round-btn:hover { border-color: rgba(255,147,23,.7); background: rgba(5,3,8,.75); transform: translateY(-1px); }
  .w-round-btn:active { transform: scale(.96); }
  .w-round-btn:focus-visible { outline: 2px solid #ff9317; outline-offset: 3px; }

  /* ── Hero ───────────────────────────────────────────────────────── */
  .w-hero { position: relative; width: 100%; aspect-ratio: 1920 / 820; min-height: 480px; max-height: 86vh; overflow: hidden; background: #050308; }
  .w-hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .w-hero-shade { position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, rgba(5,3,8,.35), rgba(5,3,8,0) 30%, rgba(5,3,8,0) 55%, rgba(5,3,8,.92)); }
  .w-hero-title {
    position: absolute; left: max(44px, calc((100% - 1400px) / 2 + 44px)); bottom: 48px; margin: 0;
    font-family: 'Madani', sans-serif; font-weight: 900;
    font-size: clamp(64px, 8.9vw, 128px); line-height: .9; letter-spacing: -0.03em;
    color: #fff; pointer-events: none;
  }
  .w-hero-mute { position: absolute; right: max(44px, calc((100% - 1400px) / 2 + 44px)); bottom: 60px; }
  .w-hero-mute .icon-unmuted { display: none; }
  .w-hero-mute[aria-pressed="false"] .icon-muted { display: none; }
  .w-hero-mute[aria-pressed="false"] .icon-unmuted { display: block; }

  /* ── Filters ────────────────────────────────────────────────────── */
  .w-filters { padding-top: 56px; }
  .w-scroll { scrollbar-width: none; }
  .w-scroll::-webkit-scrollbar { display: none; }
  .w-tabs { display: flex; gap: 12px; }
  /* Shared glass base for tabs + chips — matches .cta-btn */
  .w-tab, .w-chip {
    position: relative; isolation: isolate; overflow: hidden;
    flex: none; appearance: none; cursor: pointer; white-space: nowrap;
    display: inline-flex; align-items: center; justify-content: center;
    font-family: 'Madani', sans-serif; line-height: 1;
    color: var(--cream);
    background: rgba(10,7,16,.18);
    border: 1.5px solid rgba(255,255,255,.22);
    border-radius: 999px;
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.22),
      inset 0 -4px 10px rgba(0,0,0,.2),
      0 6px 18px rgba(0,0,0,.3);
    text-shadow: 0 0 8px rgba(0,0,0,.5);
    transition: transform .22s ease, border-color .22s ease, filter .22s ease, opacity .22s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .w-tab { height: 48px; padding: 0 22px; font-weight: 800; font-size: 16px; letter-spacing: -.2px; }
  .w-chip { height: 40px; padding: 0 18px; font-weight: 600; font-size: 14px; }

  .w-tab:hover, .w-chip:hover { transform: translateY(-1px); border-color: rgba(255,255,255,.34); filter: brightness(1.08); }
  .w-tab:active, .w-chip:active { transform: translateY(0) scale(.97); }
  .w-tab:focus-visible, .w-chip:focus-visible { outline: 2px solid var(--orange); outline-offset: 3px; }

  /* Active = animated colour blobs + specular pulse (matches .cta-btn) */
  .w-tab.is-active::before,
  .w-chip.is-active::before {
    content: ""; position: absolute; inset: -60%; z-index: -1;
    background:
      radial-gradient(circle at 20% 50%, var(--ember)  0%, transparent 18%),
      radial-gradient(circle at 70% 30%, var(--orange) 0%, transparent 16%),
      radial-gradient(circle at 60% 80%, var(--violet) 0%, transparent 20%);
    filter: blur(18px) saturate(130%);
    opacity: .7;
