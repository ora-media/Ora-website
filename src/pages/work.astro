---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import GetStartedModal from '../components/GetStartedModal.astro';

// Industry pills — first is inactive-looking, "Food & Beverage" is the active filter.
const industries = [
  { id: 'real-estate',    label: 'Real estate',      active: false },
  { id: 'food-beverage',  label: 'Food & Beverage',  active: true  },
  { id: 'schools',        label: 'Schools',          active: false },
  { id: 'clinics',        label: 'Clinics',          active: false },
  { id: 'hospitality',    label: 'Hospitality',      active: false },
  { id: 'automotive',     label: 'Automotive',       active: false },
  { id: 'products',       label: 'Products',         active: false },
];

const videoCount = 8;
const socialCount = 16;

// Photography — 4 "slides", each with 11 numbered photos matching the grid
// positions in the source layout screenshots. The grid renders 11 slots and
// cycles the whole grid between slides so slot N always shows photo N from
// the current slide.
const SLIDE_COUNT = 4;
const SLOTS_PER_SLIDE = 11;
const initialSlide = 1;

// Automotive photography — 3 slides with per-slide mosaic layouts derived from
// the source PSD pages. Slide 1 = Corvette (9 tiles), Slide 2 = Porsche GT3
// (12 tiles), Slide 3 = KTM off-road (13 tiles).
const automotiveSlides = [
  { slots: 9,  cols: 4, rows: 4 },
  { slots: 12, cols: 4, rows: 3 },
  { slots: 13, cols: 3, rows: 5 },
];

// Products photography — 3 slides, each 11 tiles matching the shared PSD mosaic
// (2 wides, 3 talls, 6 squares). Reuses the existing 11-slot photo grid layout.
const PRODUCTS_SLIDE_COUNT = 3;
const PRODUCTS_SLOTS = 11;

// Real-estate photography — 6 slides. Slides 1-4 and 6 use the standard
// 11-slot mosaic (6 sq, 2 wide, 3 tall); slide 5 uses a custom 3-column
// magazine layout with 7 portrait tiles of varying heights.
const realEstateSlides = [
  { kind: 'std' as const, slots: 11 },
  { kind: 'std' as const, slots: 11 },
  { kind: 'std' as const, slots: 11 },
  { kind: 'std' as const, slots: 11 },
  { kind: 'p5'  as const, slots: 7  },
  { kind: 'std' as const, slots: 11 },
];

// Schools photography — 3 slides. Slots per slide vary; tiles are display-only
// (no click/expand affordance).
const schoolsSlides = [
  { slots: 11 }, // Pag 1 — male graduate mosaic
  { slots: 9 },  // Pag 2 — female graduate mosaic
  { slots: 3 },  // Pag 3 — three stacked group photos
];
---
<BaseLayout title="Work — Ora Digital Media">
  <div class="work-page-bg" aria-hidden="true"></div>
  <Nav />

  <!-- ═══════════════════ HERO VIDEO ═══════════════════ -->
  <section class="work-hero">
    <video
      class="work-hero-video"
      src="/videos/work-hero.mp4"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      data-hero-video
    ></video>
    <button
      type="button"
      class="work-hero-mute"
      data-hero-mute
      aria-label="Unmute video"
      aria-pressed="true"
    >
      <svg class="icon-muted" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/>
        <path d="M16 8l6 8M22 8l-6 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
      </svg>
      <svg class="icon-unmuted" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/>
        <path d="M16 8a5 5 0 0 1 0 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
        <path d="M18.5 5.5a9 9 0 0 1 0 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
      </svg>
    </button>
  </section>

  <!-- ═══════════════════ INDUSTRY PILLS ═══════════════════ -->
  <nav class="industries" aria-label="Industries">
    <div class="industries-inner container">
      {industries.map(it => (
        <button class={`industry-pill ${it.active ? 'is-active' : ''}`} data-id={it.id}>
          {it.label}
        </button>
      ))}
    </div>
  </nav>

  <!-- ═══════════════════ PHOTOGRAPHY — FOOD & BEVERAGE ═══════════════════ -->
  <section class="cat-section" data-photo-section="food-beverage">
    <div class="container">
      <h2 class="cat-title" style="color:#fff;font-size:52px;font-weight:700;text-align:center;margin:0 0 8px;padding:0;background:transparent;letter-spacing:1px;">PHOTOGRAPHY</h2>
      <p class="cat-sub" data-industry-label style="color:#e4d9cb;font-size:15px;text-align:center;margin:0 0 40px;">Food &amp; Beverage</p>

      <div class="photo-slider" data-photo-slider data-slide-count={SLIDE_COUNT}>
        <button class="slider-arrow slider-arrow-left" data-slider-prev aria-label="Previous slide">
          <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
            <path d="M15 4 L7 12 L15 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="photo-grid" data-photo-grid data-slots={SLOTS_PER_SLIDE} data-slide={initialSlide}>
          {Array.from({ length: SLOTS_PER_SLIDE }, (_, i) => i + 1).map((n) => (
            <div
              class={`ph-tile ph-tile-${n}`}
              style={`grid-area: p${n};`}
              data-slot={n}
            >
              {/* Two stacked <img> layers cross-fade when the slide changes. */}
              <img class="ph-layer is-active" src={`/images/work/photography/slide${initialSlide}/${n}.jpg`} alt={`Photography ${n}`} onerror="this.style.display='none'" />
              <img class="ph-layer" alt="" aria-hidden="true" />
              <span class="tile-label">Photo {n}</span>
            </div>
          ))}
        </div>

        <button class="slider-arrow slider-arrow-right" data-slider-next aria-label="Next slide">
          <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
            <path d="M9 4 L17 12 L9 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

      <div class="slider-dots" data-slider-dots>
        {Array.from({ length: SLIDE_COUNT }, (_, i) => i + 1).map((n) => (
          <button
            class={`slider-dot ${n === initialSlide ? 'is-active' : ''}`}
            data-slider-goto={n}
            aria-label={`Go to slide ${n}`}
          ></button>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════ PHOTOGRAPHY — AUTOMOTIVE ═══════════════════ -->
  <section class="cat-section" data-photo-section="automotive" hidden>
    <div class="container">
      <h2 class="cat-title" style="color:#fff;font-size:52px;font-weight:700;text-align:center;margin:0 0 8px;padding:0;background:transparent;letter-spacing:1px;">PHOTOGRAPHY</h2>
      <p class="cat-sub" style="color:#e4d9cb;font-size:15px;text-align:center;margin:0 0 40px;">Automotive</p>

      <div class="photo-slider" data-auto-slider data-slide-count={automotiveSlides.length}>
        <button class="slider-arrow slider-arrow-left" data-auto-prev aria-label="Previous slide">
          <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
            <path d="M15 4 L7 12 L15 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="auto-grid-wrap" data-auto-grid-wrap>
          {automotiveSlides.map((cfg, idx) => (
            <div
              class={`auto-grid auto-grid-${idx + 1} ${idx === 0 ? 'is-active' : ''}`}
              data-auto-slide={idx + 1}
            >
              {Array.from({ length: cfg.slots }, (_, i) => i + 1).map((n) => (
                <div class={`auto-tile a-tile-${n}`} style={`grid-area: a${n};`}>
                  <img
                    src={`/images/work/photography/automotive/slide${idx + 1}/${n}.jpg`}
                    alt={`Automotive slide ${idx + 1} photo ${n}`}
                    loading="lazy"
                    onerror="this.style.display='none'"
                  />
                </div>
              ))}
            </div>
          ))}
        </div>

        <button class="slider-arrow slider-arrow-right" data-auto-next aria-label="Next slide">
          <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
            <path d="M9 4 L17 12 L9 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

      <div class="slider-dots" data-auto-dots>
        {automotiveSlides.map((_, i) => (
          <button
            class={`slider-dot ${i === 0 ? 'is-active' : ''}`}
            data-auto-goto={i + 1}
            aria-label={`Go to slide ${i + 1}`}
          ></button>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════ PHOTOGRAPHY — REAL ESTATE ═══════════════════ -->
  <section class="cat-section" data-photo-section="real-estate" hidden>
    <div class="container">
      <h2 class="cat-title" style="color:#fff;font-size:52px;font-weight:700;text-align:center;margin:0 0 8px;padding:0;background:transparent;letter-spacing:1px;">PHOTOGRAPHY</h2>
      <p class="cat-sub" style="color:#e4d9cb;font-size:15px;text-align:center;margin:0 0 40px;">Real estate</p>

      <div class="photo-slider" data-re-slider data-slide-count={realEstateSlides.length}>
        <button class="slider-arrow slider-arrow-left" data-re-prev aria-label="Previous slide">
          <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
            <path d="M15 4 L7 12 L15 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="re-grid-wrap" data-re-grid-wrap>
          {realEstateSlides.map((cfg, idx) => (
            <div
              class={`re-grid re-grid-${cfg.kind} ${idx === 0 ? 'is-active' : ''}`}
              data-re-slide={idx + 1}
            >
              {cfg.kind === 'std' ? (
                Array.from({ length: cfg.slots }, (_, i) => i + 1).map((n) => (
                  <div class={`re-tile re-tile-${n}`} style={`grid-area: p${n};`}>
                    <img
                      src={`/images/work/photography/real-estate/slide${idx + 1}/${n}.jpg`}
                      alt={`Real estate slide ${idx + 1} photo ${n}`}
                      loading="lazy"
                      onerror="this.style.display='none'"
                    />
                  </div>
                ))
              ) : (
                <>
                  <div class="re5-col">
                    {[1, 2].map((n) => (
                      <div class="re-tile" style={`aspect-ratio: 1615 / ${n === 1 ? 2474 : 2483};`}>
                        <img src={`/images/work/photography/real-estate/slide${idx + 1}/${n}.jpg`} alt={`Real estate slide ${idx + 1} photo ${n}`} loading="lazy" onerror="this.style.display='none'" />
                      </div>
                    ))}
                  </div>
                  <div class="re5-col">
                    <div class="re-tile" style="aspect-ratio: 1615 / 3385;">
                      <img src={`/images/work/photography/real-estate/slide${idx + 1}/3.jpg`} alt={`Real estate slide ${idx + 1} photo 3`} loading="lazy" onerror="this.style.display='none'" />
                    </div>
                    <div class="re-tile" style="aspect-ratio: 1615 / 2161;">
                      <img src={`/images/work/photography/real-estate/slide${idx + 1}/4.jpg`} alt={`Real estate slide ${idx + 1} photo 4`} loading="lazy" onerror="this.style.display='none'" />
                    </div>
                  </div>
                  <div class="re5-col">
                    <div class="re-tile" style="aspect-ratio: 1615 / 1969;">
                      <img src={`/images/work/photography/real-estate/slide${idx + 1}/5.jpg`} alt={`Real estate slide ${idx + 1} photo 5`} loading="lazy" onerror="this.style.display='none'" />
                    </div>
                    <div class="re-tile" style="aspect-ratio: 1615 / 3385;">
                      <img src={`/images/work/photography/real-estate/slide${idx + 1}/6.jpg`} alt={`Real estate slide ${idx + 1} photo 6`} loading="lazy" onerror="this.style.display='none'" />
                    </div>
                    <div class="re-tile" style="aspect-ratio: 1 / 1;">
                      <img src={`/images/work/photography/real-estate/slide${idx + 1}/7.jpg`} alt={`Real estate slide ${idx + 1} photo 7`} loading="lazy" onerror="this.style.display='none'" />
                    </div>
                  </div>
                </>
              )}
            </div>
          ))}
        </div>

        <button class="slider-arrow slider-arrow-right" data-re-next aria-label="Next slide">
          <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
            <path d="M9 4 L17 12 L9 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

      <div class="slider-dots" data-re-dots>
        {realEstateSlides.map((_, i) => (
          <button
            class={`slider-dot ${i === 0 ? 'is-active' : ''}`}
            data-re-goto={i + 1}
            aria-label={`Go to slide ${i + 1}`}
          ></button>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════ PHOTOGRAPHY — SCHOOLS ═══════════════════ -->
  <section class="cat-section" data-photo-section="schools" hidden>
    <div class="container">
      <h2 class="cat-title" style="color:#fff;font-size:52px;font-weight:700;text-align:center;margin:0 0 8px;padding:0;background:transparent;letter-spacing:1px;">PHOTOGRAPHY</h2>
      <p class="cat-sub" style="color:#e4d9cb;font-size:15px;text-align:center;margin:0 0 40px;">Schools</p>

      <div class="photo-slider" data-schools-slider data-slide-count={schoolsSlides.length}>
        <button class="slider-arrow slider-arrow-left" data-schools-prev aria-label="Previous slide">
          <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
            <path d="M15 4 L7 12 L15 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="schools-grid-wrap" data-schools-grid-wrap>
          {schoolsSlides.map((cfg, idx) => (
            <div
              class={`schools-grid schools-grid-${idx + 1} ${idx === 0 ? 'is-active' : ''}`}
              data-schools-slide={idx + 1}
            >
              {Array.from({ length: cfg.slots }, (_, i) => i + 1).map((n) => (
                <div class={`schools-tile s-ptile-${n}`} style={`grid-area: s${n};`} data-no-expand>
                  <img
                    src={`/images/work/photography/schools/slide${idx + 1}/${n}.jpg`}
                    alt={`Schools slide ${idx + 1} photo ${n}`}
                    loading="lazy"
                    draggable="false"
                    onerror="this.style.display='none'"
                  />
                </div>
              ))}
            </div>
          ))}
        </div>

        <button class="slider-arrow slider-arrow-right" data-schools-next aria-label="Next slide">
          <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
            <path d="M9 4 L17 12 L9 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

      <div class="slider-dots" data-schools-dots>
        {schoolsSlides.map((_, i) => (
          <button
            class={`slider-dot ${i === 0 ? 'is-active' : ''}`}
            data-schools-goto={i + 1}
            aria-label={`Go to slide ${i + 1}`}
          ></button>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════ PHOTOGRAPHY — PRODUCTS ═══════════════════ -->
  <section class="cat-section" data-photo-section="products" hidden>
    <div class="container">
      <h2 class="cat-title" style="color:#fff;font-size:52px;font-weight:700;text-align:center;margin:0 0 8px;padding:0;background:transparent;letter-spacing:1px;">PHOTOGRAPHY</h2>
      <p class="cat-sub" style="color:#e4d9cb;font-size:15px;text-align:center;margin:0 0 40px;">Products</p>

      <div class="photo-slider" data-prod-slider data-slide-count={PRODUCTS_SLIDE_COUNT}>
        <button class="slider-arrow slider-arrow-left" data-prod-prev aria-label="Previous slide">
          <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
            <path d="M15 4 L7 12 L15 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="photo-grid" data-prod-grid data-slots={PRODUCTS_SLOTS} data-slide={1}>
          {Array.from({ length: PRODUCTS_SLOTS }, (_, i) => i + 1).map((n) => (
            <div class={`ph-tile ph-tile-${n}`} style={`grid-area: p${n};`} data-slot={n}>
              <img class="ph-layer is-active" src={`/images/work/photography/products/slide1/${n}.jpg`} alt={`Products ${n}`} onerror="this.style.display='none'" />
              <img class="ph-layer" alt="" aria-hidden="true" />
              <span class="tile-label">Photo {n}</span>
            </div>
          ))}
        </div>

        <button class="slider-arrow slider-arrow-right" data-prod-next aria-label="Next slide">
          <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
            <path d="M9 4 L17 12 L9 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

      <div class="slider-dots" data-prod-dots>
        {Array.from({ length: PRODUCTS_SLIDE_COUNT }, (_, i) => i + 1).map((n) => (
          <button
            class={`slider-dot ${n === 1 ? 'is-active' : ''}`}
            data-prod-goto={n}
            aria-label={`Go to slide ${n}`}
          ></button>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════ VIDEOGRAPHY ═══════════════════ -->
  <section class="cat-section">
    <div class="container">
      <h2 class="cat-title" style="color:#fff;font-size:52px;font-weight:700;text-align:center;margin:0 0 8px;padding:0;background:transparent;letter-spacing:1px;">VIDEOGRAPHY</h2>
      <p class="cat-sub" data-industry-label style="color:#e4d9cb;font-size:15px;text-align:center;margin:0 0 40px;">Food &amp; Beverage</p>

      <div class="video-grid">
        {Array.from({length: videoCount}).map((_, i) => (
          <div class={`video-tile v-tile-${i+1}`}>
            <video
              src={`/images/work/video/${i+1}.mp4`}
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              onerror="this.style.display='none'"
            ></video>
            <svg viewBox="0 0 100 100" class="video-play" aria-hidden="true">
              <path d="M38 30 L74 50 L38 70 Z" fill="rgba(0,0,0,0.4)" />
            </svg>
            <span class="tile-label tile-label-dark">Video {i+1}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════ SOCIAL MEDIA ═══════════════════ -->
  <section class="cat-section">
    <div class="container">
      <h2 class="cat-title cat-title-plain" style="color:#fff;font-size:52px;font-weight:700;text-align:center;margin:0 0 44px;padding:0;background:transparent;letter-spacing:1px;">Social Media</h2>

      <div class="social-slider" data-social-slider>
        <button class="slider-arrow slider-arrow-left" data-social-prev aria-label="Previous client">
          <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
            <path d="M15 4 L7 12 L15 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="social-slides" data-social-slides>
          {[
            { id: 'mahrouseh', title: 'Mahrouseh', desc: "Mahrouseh is a Syrian restaurant based in Sharjah, UAE. We've been managing its social media presence for over two years, creating content that reflects the authenticity of Syrian cuisine while building a strong and engaging online community. Through a consistent content strategy and creative storytelling, we've helped strengthen the brand's digital presence and connect with a wider audience." },
            { id: 'mandi',     title: 'Mandi Street', desc: "Mandi Street brings traditional Yemeni mandi to a modern audience. We craft its social content across campaigns and everyday posts — from bold promo creatives to appetite-driving lifestyle imagery — building a distinctive voice that keeps the brand top-of-mind." },
          ].map((client, idx) => (
            <div class={`social-block ${idx === 0 ? 'is-active' : ''}`} data-social-slide={idx + 1}>
              <h3 class="social-client-title">{client.title}</h3>
              <div class="social-mosaic">
                {Array.from({ length: socialCount }, (_, i) => i + 1).map((n) => (
                  <div class={`social-tile s-tile-${n} ${n % 2 === 1 ? 'is-tall' : 'is-medium'}`}>
                    <img src={`/images/work/social/${client.id}/${n}.jpg`} alt={`${client.title} social ${n}`} loading="lazy" onerror="this.style.display='none'" />
                  </div>
                ))}
              </div>
              <p class="social-desc">{client.desc}</p>
            </div>
          ))}
        </div>

        <button class="slider-arrow slider-arrow-right" data-social-next aria-label="Next client">
          <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
            <path d="M9 4 L17 12 L9 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

      <div class="slider-dots" data-social-dots>
        {[1, 2].map((n) => (
          <button
            class={`slider-dot ${n === 1 ? 'is-active' : ''}`}
            data-social-goto={n}
            aria-label={`Go to client ${n}`}
          ></button>
        ))}
      </div>
    </div>
  </section>

  <Footer />
  <GetStartedModal />
</BaseLayout>

<script>
  /* ═══════════════════════════════════════════════════════════════════
     INDUSTRY FILTER
     Click a pill → visually mark active, update all "Food & Beverage"
     subtitle labels, toggle image visibility for non-F&B industries.
     ═══════════════════════════════════════════════════════════════════ */
  const pills  = Array.from(document.querySelectorAll<HTMLButtonElement>('.industry-pill'));
  const labels = Array.from(document.querySelectorAll<HTMLElement>('[data-industry-label]'));
  const page   = document.querySelector<HTMLElement>('.work-page-bg')?.parentElement;

  let currentIndustry = 'food-beverage';

  const applyIndustry = (id: string, label: string) => {
    currentIndustry = id;
    for (const p of pills) p.classList.toggle('is-active', p.dataset.id === id);
    for (const l of labels) l.textContent = label;
    if (page) page.setAttribute('data-industry', id);

    // Toggle which photography section is visible based on industry.
    const photoSections = document.querySelectorAll<HTMLElement>('[data-photo-section]');
    photoSections.forEach(sec => {
      const match = sec.dataset.photoSection === id;
      sec.hidden = !match;
    });

    // Only F&B has curated video + social imagery; hide those for other industries.
    const showFbMedia = id === 'food-beverage';
    document.querySelectorAll<HTMLImageElement>('.social-tile img')
      .forEach(img => { img.style.display = showFbMedia ? '' : 'none'; });
    document.querySelectorAll<HTMLVideoElement>('.video-tile video')
      .forEach(v => { v.style.display = showFbMedia ? '' : 'none'; });
  };

  for (const p of pills) {
    p.addEventListener('click', () => {
      const id = p.dataset.id!;
      const label = p.textContent?.trim() || '';
      applyIndustry(id, label);
    });
  }

  /* ═══════════════════════════════════════════════════════════════════
     PHOTOGRAPHY SLIDER
     Manual left/right navigation across 4 slides. Slot n always shows
     photo n of the current slide. Two <img> layers per tile crossfade
     when the slide changes.
     ═══════════════════════════════════════════════════════════════════ */
  const sliderEl = document.querySelector<HTMLElement>('[data-photo-slider]');
  const photoGridEl = document.querySelector<HTMLElement>('[data-photo-grid]');
  const SLIDE_COUNT = parseInt(sliderEl?.dataset.slideCount || '4', 10);
  const TILE_STAGGER_MS = 60;
  let currentSlide = 1;

  type SlotState = { layers: [HTMLImageElement, HTMLImageElement]; active: 0|1; slotNum: number };
  const slots: SlotState[] = [];

  const initSlots = () => {
    slots.length = 0;
    const els = Array.from(document.querySelectorAll<HTMLElement>('.ph-tile[data-slot]'));
    for (const el of els) {
      const layers = el.querySelectorAll<HTMLImageElement>('.ph-layer');
      if (layers.length !== 2) continue;
      slots.push({
        layers: [layers[0], layers[1]],
        active: 0,
        slotNum: parseInt(el.dataset.slot || '1', 10),
      });
    }
  };

  // Preload every image for a slide; resolves when all are ready
  // (or errored). Used to hold the flip until the new page is loaded.
  const preloadSlide = (slide: number) => Promise.all(
    slots.map((s) => new Promise<void>((resolve) => {
      const img = new Image();
      img.onload = () => resolve();
      img.onerror = () => resolve();
      img.src = `/images/work/photography/slide${slide}/${s.slotNum}.jpg`;
    }))
  );

  // Swap every tile's image instantly (no crossfade). Used while the
  // grid is hidden mid-flip so the swap is invisible.
  const swapSlideInstant = (slide: number) => {
    if (!slots.length) initSlots();
    for (const s of slots) {
      const src = `/images/work/photography/slide${slide}/${s.slotNum}.jpg`;
      s.layers[s.active].src = src;
      s.layers[1 - s.active as 0|1].src = src;
    }
  };

  const dotEls = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-slider-goto]'));
  const setActiveDot = (slide: number) => {
    for (const d of dotEls) d.classList.toggle('is-active', parseInt(d.dataset.sliderGoto || '0', 10) === slide);
  };

  const DISTORT_OUT_MS = 500; // must match the CSS transition duration
  let isFlipping = false;

  const goToSlide = async (slide: number) => {
    const target = ((slide - 1 + SLIDE_COUNT) % SLIDE_COUNT) + 1;
    if (target === currentSlide || isFlipping) return;
    isFlipping = true;

    // Preload the new slide's photos before we even start the flip so
    // the reveal shows the finished page, not a half-loaded one.
    const preload = preloadSlide(target);

    // Flip the grid edge-on and fade it out — the layout swap happens
    // while it's invisible, then it flips back in on the new slide.
    photoGridEl?.classList.add('is-swapping');

    // Wait for both the flip-out animation AND the preload to finish.
    await Promise.all([
      new Promise<void>((r) => window.setTimeout(r, DISTORT_OUT_MS)),
      preload,
    ]);

    // Swap invisibly.
    currentSlide = target;
    if (photoGridEl) photoGridEl.dataset.slide = String(currentSlide);
    setActiveDot(currentSlide);
    swapSlideInstant(currentSlide);

    // Force a reflow so the browser commits the new src + layout
    // before we start the flip-back-in animation.
    void photoGridEl?.offsetWidth;

    photoGridEl?.classList.remove('is-swapping');
    window.setTimeout(() => { isFlipping = false; }, DISTORT_OUT_MS);
  };

  document.querySelector<HTMLButtonElement>('[data-slider-prev]')
    ?.addEventListener('click', () => goToSlide(currentSlide - 1));
  document.querySelector<HTMLButtonElement>('[data-slider-next]')
    ?.addEventListener('click', () => goToSlide(currentSlide + 1));
  for (const d of dotEls) {
    d.addEventListener('click', () => goToSlide(parseInt(d.dataset.sliderGoto || '1', 10)));
  }

  // Arrow keys work when the slider (or its children) has focus.
  sliderEl?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft')  { e.preventDefault(); goToSlide(currentSlide - 1); }
    if (e.key === 'ArrowRight') { e.preventDefault(); goToSlide(currentSlide + 1); }
  });

  /* ═══════════════════════════════════════════════════════════════════
     PRODUCTS PHOTO SLIDER — mirrors the F&B slider (distortion flip + preload)
     but keeps its own state on a separate 11-slot grid.
     ═══════════════════════════════════════════════════════════════════ */
  const prodSliderEl = document.querySelector<HTMLElement>('[data-prod-slider]');
  const prodGridEl   = document.querySelector<HTMLElement>('[data-prod-grid]');
  const PROD_COUNT   = parseInt(prodSliderEl?.dataset.slideCount || '3', 10);
  const prodDotEls   = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-prod-goto]'));
  let prodSlide = 1;
  let prodFlipping = false;

  type ProdSlotState = { layers: [HTMLImageElement, HTMLImageElement]; active: 0|1; slotNum: number };
  const prodSlots: ProdSlotState[] = [];
  const initProdSlots = () => {
    prodSlots.length = 0;
    const els = Array.from(prodGridEl?.querySelectorAll<HTMLElement>('.ph-tile[data-slot]') || []);
    for (const el of els) {
      const layers = el.querySelectorAll<HTMLImageElement>('.ph-layer');
      if (layers.length !== 2) continue;
      prodSlots.push({
        layers: [layers[0], layers[1]],
        active: 0,
        slotNum: parseInt(el.dataset.slot || '1', 10),
      });
    }
  };
  const preloadProdSlide = (slide: number) => Promise.all(
    prodSlots.map((s) => new Promise<void>((resolve) => {
      const img = new Image();
      img.onload = () => resolve();
      img.onerror = () => resolve();
      img.src = `/images/work/photography/products/slide${slide}/${s.slotNum}.jpg`;
    }))
  );
  const swapProdSlideInstant = (slide: number) => {
    if (!prodSlots.length) initProdSlots();
    for (const s of prodSlots) {
      const src = `/images/work/photography/products/slide${slide}/${s.slotNum}.jpg`;
      s.layers[s.active].src = src;
      s.layers[1 - s.active as 0|1].src = src;
    }
  };
  const setProdActiveDot = (slide: number) => {
    for (const d of prodDotEls) d.classList.toggle('is-active', parseInt(d.dataset.prodGoto || '0', 10) === slide);
  };
  const goToProdSlide = async (slide: number) => {
    const target = ((slide - 1 + PROD_COUNT) % PROD_COUNT) + 1;
    if (target === prodSlide || prodFlipping) return;
    prodFlipping = true;
    const preload = preloadProdSlide(target);
    prodGridEl?.classList.add('is-swapping');
    await Promise.all([
      new Promise<void>((r) => window.setTimeout(r, 500)),
      preload,
    ]);
    prodSlide = target;
    if (prodGridEl) prodGridEl.dataset.slide = String(prodSlide);
    setProdActiveDot(prodSlide);
    swapProdSlideInstant(prodSlide);
    void prodGridEl?.offsetWidth;
    prodGridEl?.classList.remove('is-swapping');
    window.setTimeout(() => { prodFlipping = false; }, 500);
  };
  document.querySelector<HTMLButtonElement>('[data-prod-prev]')
    ?.addEventListener('click', () => goToProdSlide(prodSlide - 1));
  document.querySelector<HTMLButtonElement>('[data-prod-next]')
    ?.addEventListener('click', () => goToProdSlide(prodSlide + 1));
  for (const d of prodDotEls) {
    d.addEventListener('click', () => goToProdSlide(parseInt(d.dataset.prodGoto || '1', 10)));
  }

  /* ═══════════════════════════════════════════════════════════════════
     SOCIAL MEDIA SLIDER — fade between client mosaics.
     ═══════════════════════════════════════════════════════════════════ */
  const socialSlides = Array.from(document.querySelectorAll<HTMLElement>('[data-social-slide]'));
  const socialDots   = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-social-goto]'));
  const SOC_COUNT = socialSlides.length;
  let socSlide = 1;
  const goToSocSlide = (n: number) => {
    const target = ((n - 1 + SOC_COUNT) % SOC_COUNT) + 1;
    if (target === socSlide) return;
    socSlide = target;
    for (const s of socialSlides) s.classList.toggle('is-active', parseInt(s.dataset.socialSlide || '0', 10) === socSlide);
    for (const d of socialDots)   d.classList.toggle('is-active', parseInt(d.dataset.socialGoto || '0', 10) === socSlide);
  };
  document.querySelector<HTMLButtonElement>('[data-social-prev]')
    ?.addEventListener('click', () => goToSocSlide(socSlide - 1));
  document.querySelector<HTMLButtonElement>('[data-social-next]')
    ?.addEventListener('click', () => goToSocSlide(socSlide + 1));
  for (const d of socialDots) {
    d.addEventListener('click', () => goToSocSlide(parseInt(d.dataset.socialGoto || '1', 10)));
  }

  /* ═══════════════════════════════════════════════════════════════════
     REAL ESTATE PHOTO SLIDER — fade between 6 preset mosaic slides (5
     standard 11-slot + 1 custom 3-column magazine).
     ═══════════════════════════════════════════════════════════════════ */
  const reGrids = Array.from(document.querySelectorAll<HTMLElement>('[data-re-slide]'));
  const reDots  = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-re-goto]'));
  const RE_COUNT = reGrids.length;
  let reSlide = 1;
  const goToReSlide = (n: number) => {
    const target = ((n - 1 + RE_COUNT) % RE_COUNT) + 1;
    if (target === reSlide) return;
    reSlide = target;
    for (const g of reGrids) g.classList.toggle('is-active', parseInt(g.dataset.reSlide || '0', 10) === reSlide);
    for (const d of reDots)  d.classList.toggle('is-active', parseInt(d.dataset.reGoto || '0', 10) === reSlide);
  };
  document.querySelector<HTMLButtonElement>('[data-re-prev]')
    ?.addEventListener('click', () => goToReSlide(reSlide - 1));
  document.querySelector<HTMLButtonElement>('[data-re-next]')
    ?.addEventListener('click', () => goToReSlide(reSlide + 1));
  for (const d of reDots) {
    d.addEventListener('click', () => goToReSlide(parseInt(d.dataset.reGoto || '1', 10)));
  }

  /* ═══════════════════════════════════════════════════════════════════
     SCHOOLS PHOTO SLIDER — fade between preset mosaic slides. Tiles are
     marked [data-no-expand] to prevent any future lightbox affordance.
     ═══════════════════════════════════════════════════════════════════ */
  const schoolsGrids = Array.from(document.querySelectorAll<HTMLElement>('[data-schools-slide]'));
  const schoolsDots  = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-schools-goto]'));
  const SCHOOLS_COUNT = schoolsGrids.length;
  let schoolsSlide = 1;
  const goToSchoolsSlide = (n: number) => {
    const target = ((n - 1 + SCHOOLS_COUNT) % SCHOOLS_COUNT) + 1;
    if (target === schoolsSlide) return;
    schoolsSlide = target;
    for (const g of schoolsGrids) g.classList.toggle('is-active', parseInt(g.dataset.schoolsSlide || '0', 10) === schoolsSlide);
    for (const d of schoolsDots)  d.classList.toggle('is-active', parseInt(d.dataset.schoolsGoto || '0', 10) === schoolsSlide);
  };
  document.querySelector<HTMLButtonElement>('[data-schools-prev]')
    ?.addEventListener('click', () => goToSchoolsSlide(schoolsSlide - 1));
  document.querySelector<HTMLButtonElement>('[data-schools-next]')
    ?.addEventListener('click', () => goToSchoolsSlide(schoolsSlide + 1));
  for (const d of schoolsDots) {
    d.addEventListener('click', () => goToSchoolsSlide(parseInt(d.dataset.schoolsGoto || '1', 10)));
  }

  /* ═══════════════════════════════════════════════════════════════════
     AUTOMOTIVE PHOTO SLIDER — simple fade between 3 preset mosaic slides.
     ═══════════════════════════════════════════════════════════════════ */
  const autoGrids = Array.from(document.querySelectorAll<HTMLElement>('[data-auto-slide]'));
  const autoDots  = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-auto-goto]'));
  const AUTO_COUNT = autoGrids.length;
  let autoSlide = 1;

  const goToAutoSlide = (n: number) => {
    const target = ((n - 1 + AUTO_COUNT) % AUTO_COUNT) + 1;
    if (target === autoSlide) return;
    autoSlide = target;
    for (const g of autoGrids) g.classList.toggle('is-active', parseInt(g.dataset.autoSlide || '0', 10) === autoSlide);
    for (const d of autoDots)  d.classList.toggle('is-active', parseInt(d.dataset.autoGoto || '0', 10) === autoSlide);
  };

  document.querySelector<HTMLButtonElement>('[data-auto-prev]')
    ?.addEventListener('click', () => goToAutoSlide(autoSlide - 1));
  document.querySelector<HTMLButtonElement>('[data-auto-next]')
    ?.addEventListener('click', () => goToAutoSlide(autoSlide + 1));
  for (const d of autoDots) {
    d.addEventListener('click', () => goToAutoSlide(parseInt(d.dataset.autoGoto || '1', 10)));
  }

  /* ═══════════════════════════════════════════════════════════════════
     HERO VIDEO MUTE TOGGLE
     Video starts muted so autoplay works across browsers; the button
     lets the user unmute (and re-mute) at will.
     ═══════════════════════════════════════════════════════════════════ */
  const heroVideo = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const heroMuteBtn = document.querySelector<HTMLButtonElement>('[data-hero-mute]');

  if (heroVideo && heroMuteBtn) {
    const sync = () => {
      heroMuteBtn.setAttribute('aria-pressed', String(heroVideo.muted));
      heroMuteBtn.setAttribute('aria-label', heroVideo.muted ? 'Unmute video' : 'Mute video');
    };
    heroMuteBtn.addEventListener('click', () => {
      heroVideo.muted = !heroVideo.muted;
      if (!heroVideo.muted) heroVideo.play().catch(() => {});
      sync();
    });
    heroVideo.addEventListener('volumechange', sync);
    sync();
  }
</script>

<style>
