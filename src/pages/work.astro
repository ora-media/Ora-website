  }
  /* Cross-fade + gentle "reveal" scale on Photography tiles. Two <img> layers
     stacked; JS swaps the inactive layer's src, waits for decode, then flips
     .is-active → CSS handles the smooth opacity fade AND a subtle 1.05→1
     scale so the incoming image reads as a "reveal" instead of a raw dissolve. */
  .ph-tile { transform: translateZ(0); }  /* isolate stacking context */
  .ph-tile .ph-layer {
