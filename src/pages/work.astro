---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import GetStartedModal from '../components/GetStartedModal.astro';
import workVideos from '../data/work-videos.json';

// Videos are served from Cloudflare R2 in production (PUBLIC_MEDIA_BASE).
const MEDIA_BASE = import.meta.env.PUBLIC_MEDIA_BASE ?? '';

type Medium = 'photo' | 'video' | 'social';
type Item = {
  src: string; type: Medium; ind: string; title: string;
  desc?: string; noExpand?: boolean;
  poster?: string; aspect?: string; wide?: boolean;
};

const industries = [
  { id: 'real-estate',   label: 'Real estate' },
  { id: 'food-beverage', label: 'Food & Beverage' },
  { id: 'schools',       label: 'Schools' },
  { id: 'hospitality',   label: 'Hospitality' },
  { id: 'automotive',    label: 'Automotive' },
  { id: 'products',      label: 'Products' },
  { id: 'corporate',     label: 'Corporate' },
  { id: 'events',        label: 'Events' },
];
const indLabel = Object.fromEntries(industries.map(i => [i.id, i.label]));
const media = [
  { id: 'all',    label: 'All Work' },
  { id: 'photo',  label: 'Photography' },
  { id: 'video',  label: 'Videography' },
  { id: 'social', label: 'Social Media' },
];
const medLabel: Record<Medium, string> = { photo: 'Photography', video: 'Videography', social: 'Social Media' };

const range = (n: number) => Array.from({ length: n }, (_, i) => i + 1);
const photoSet = (dir: string, slots: number[], ind: string, titles?: string[], noExpand = false, wideSlides: number[] = []): Item[] =>
  slots.flatMap((count, s) => range(count).map(k => ({
    src: `/images/work/photography/${dir}slide${s + 1}/${k}.jpg`, type: 'photo' as const, ind,
    title: titles?.[s] ?? indLabel[ind], noExpand,
    wide: wideSlides.includes(s + 1),
  })));

const social = [
  { id: 'mahrouseh', title: 'Mahrouseh', desc: "Mahrouseh is a Syrian restaurant based in Sharjah, UAE. We've been managing its social media presence for over two years, creating content that reflects the authenticity of Syrian cuisine while building a strong and engaging online community. Through a consistent content strategy and creative storytelling, we've helped strengthen the brand's digital presence and connect with a wider audience." },
  { id: 'mandi',     title: 'Mandi Street', desc: "Mandi Street brings traditional Yemeni mandi to a modern audience. We craft its social content across campaigns and everyday posts — from bold promo creatives to appetite-driving lifestyle imagery — building a distinctive voice that keeps the brand top-of-mind." },
];

// Videos hosted on R2 under videos/work/<industry>/N.mp4 (+ N.jpg poster).
// src/data/work-videos.json carries each clip's real pixel dimensions so
// portraits and landscapes render at their true aspect.
const videoSet = (ind: string): Item[] => {
  const list = (workVideos as Record<string, { n: number; w: number; h: number }[]>)[ind] ?? [];
  return list.map(v => ({
    src:    `${MEDIA_BASE}/videos/work/${ind}/${v.n}.mp4`,
    poster: `${MEDIA_BASE}/videos/work/${ind}/${v.n}.jpg`,
    aspect: `${v.w} / ${v.h}`,
    type:   'video' as const,
    ind,
    title:  indLabel[ind],
  }));
};

// Groups are interleaved round-robin so "All Work" reads as a varied wall.
const groups: Item[][] = [
  photoSet('', [11, 11, 11, 11], 'food-beverage'),
  photoSet('automotive/', [9, 12, 13], 'automotive', ['Corvette', 'Porsche GT3', 'KTM Off-road']),
  videoSet('automotive'),
  videoSet('corporate'),
  videoSet('events'),
  videoSet('food-beverage'),
  videoSet('hospitality'),
  videoSet('real-estate'),
  videoSet('schools'),
  range(8).map(n => ({ src: `${MEDIA_BASE}/images/work/video/${n}.mp4`, type: 'video' as const, ind: 'food-beverage', title: 'Food & Beverage' })),
  photoSet('real-estate/', [11, 11, 11, 11], 'real-estate'),
  social.flatMap(c => range(16).map(n => ({ src: `/images/work/social/${c.id}/${n}.jpg`, type: 'social' as const, ind: 'food-beverage', title: c.title, desc: c.desc }))),
  photoSet('hospitality/', [11, 7], 'hospitality'),
  photoSet('products/', [11, 11, 11], 'products'),
  [
    ...photoSet('schools/', [11, 9], 'schools', ['Graduation', 'Graduation'], true),
    // slide4 (framed) sits above the wide panoramics in the regular
    // masonry — same tile size as every other schools photo.
    ...range(3).map(k => ({ src: `/images/work/photography/schools/slide4/${k}.jpg`, type: 'photo' as const, ind: 'schools', title: 'Graduation', noExpand: true })),
    // slide3 (panoramic group shots) are the only wide/feature tiles.
    ...range(3).map(k => ({ src: `/images/work/photography/schools/slide3/${k}.jpg`, type: 'photo' as const, ind: 'schools', title: 'Graduation', noExpand: true, wide: true })),
  ],
];
const items: Item[] = [];
for (let i = 0; groups.some(g => i < g.length); i++) for (const g of groups) if (i < g.length) items.push(g[i]);
// Videos live in the centre-stage rail; the grid holds photos + social only.
const videoItems  = items.filter(it => it.type === 'video');
const normalItems = items.filter(it => it.type !== 'video' && !it.wide);
const wideItems   = items.filter(it => it.type !== 'video' &&  it.wide);
const isWideVideo = (ar?: string) => {
  if (!ar) return false;
  const [w, h] = ar.split('/').map(s => parseFloat(s.trim()));
  return w > 0 && h > 0 && w > h;
};
---
<BaseLayout title="Work — Ora Digital Media">
  <div class="work-page-bg" aria-hidden="true"></div>
  <Nav />

  <!-- ═══════════ HERO REEL (full-bleed) ═══════════ -->
  <section class="w-hero">
    <video class="w-hero-video" autoplay muted loop playsinline preload="auto" data-hero-video>
      <source src={`${MEDIA_BASE}/videos/work-hero.webm`} type="video/webm" />
      <source src={`${MEDIA_BASE}/videos/work-hero.mp4`} type="video/mp4" />
    </video>
    <div class="w-hero-shade" aria-hidden="true"></div>
    <h1 class="w-hero-title">Work</h1>
    <button type="button" class="w-round-btn w-hero-mute" data-hero-mute aria-label="Unmute video" aria-pressed="true">
      <svg class="icon-muted" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/><path d="M16 9l5 6M21 9l-5 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/></svg>
      <svg class="icon-unmuted" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/><path d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/></svg>
    </button>
  </section>

  <!-- ═══════════ FILTERS ═══════════ -->
  <div class="w-filters container">
    <div class="w-tabs w-scroll" role="tablist" aria-label="Medium">
      {media.map((m, i) => (
        <button type="button" role="tab" class={`w-tab ${i === 0 ? 'is-active' : ''}`} data-med={m.id} aria-selected={i === 0 ? 'true' : 'false'}>
          {m.label}<span class="w-tab-hint">Food &amp; Beverage only</span>
        </button>
      ))}
    </div>
    <div class="w-chiprow">
      <div class="w-chips w-scroll" aria-label="Industry">
        <button type="button" class="w-chip is-active" data-ind="all" aria-pressed="true">All</button>
        {industries.map(it => (
          <button type="button" class="w-chip" data-ind={it.id} aria-pressed="false">{it.label}</button>
        ))}
      </div>
      <span class="w-count" data-count></span>
    </div>
  </div>

  <!-- ═══════════ VIDEO RAIL — 4a (Videography tab) + 5a (All Work) ═══════════ -->
  {videoItems.length > 0 && (
    <>
      <section class="v-section v-4a" data-rail-wrap="4a" hidden>
        <div class="v-stage">
          <div class="v-rail" data-rail="4a" tabindex="0">
            {videoItems.map(v => (
              <div
                class="v-card"
                data-type="video"
                data-ind={v.ind}
                data-wide={isWideVideo(v.aspect) ? 'true' : 'false'}
                data-src={v.src}
                data-title={v.title}
                data-cat={`${indLabel[v.ind]} · Videography`}
                data-desc={v.desc ?? ''}
                data-aspect={v.aspect}
                style={v.poster ? `background-image:url(${v.poster})` : undefined}
                tabindex="0"
                role="button"
                aria-label={`Open ${v.title}`}
              >
                <video muted loop playsinline preload="none">
                  <source src={`${v.src.replace(/\.mp4$/, '.webm')}#t=0.1`} type="video/webm" />
                  <source src={`${v.src}#t=0.1`} type="video/mp4" />
                </video>
                <span class="v-progress" aria-hidden="true"></span>
              </div>
            ))}
          </div>
          <div class="v-fade v-fade-l" aria-hidden="true"></div>
          <div class="v-fade v-fade-r" aria-hidden="true"></div>
        </div>
        <div class="v-footer">
          <button type="button" class="v-arrow" data-rail-prev="4a" aria-label="Previous">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="v-info">
            <p class="v-pos" data-rail-pos="4a"></p>
            <p class="v-title" data-rail-title="4a"></p>
          </div>
          <button type="button" class="v-arrow" data-rail-next="4a" aria-label="Next">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </section>

      <section class="v-section v-5a" data-rail-wrap="5a" hidden>
        <div class="v-header">
          <div class="v-info">
            <p class="v-pos" data-rail-pos="5a"></p>
            <p class="v-title" data-rail-title="5a"></p>
          </div>
          <div class="v-nav">
            <button type="button" class="v-arrow" data-rail-prev="5a" aria-label="Previous">
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" class="v-arrow" data-rail-next="5a" aria-label="Next">
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        </div>
        <div class="v-stage">
          <div class="v-rail" data-rail="5a" tabindex="0">
            {videoItems.map(v => (
              <div
                class="v-card"
                data-type="video"
                data-ind={v.ind}
                data-wide={isWideVideo(v.aspect) ? 'true' : 'false'}
                data-src={v.src}
                data-title={v.title}
                data-cat={`${indLabel[v.ind]} · Videography`}
                data-desc={v.desc ?? ''}
                data-aspect={v.aspect}
                style={v.poster ? `background-image:url(${v.poster})` : undefined}
                tabindex="0"
                role="button"
                aria-label={`Open ${v.title}`}
              >
                <video muted loop playsinline preload="none">
                  <source src={`${v.src.replace(/\.mp4$/, '.webm')}#t=0.1`} type="video/webm" />
                  <source src={`${v.src}#t=0.1`} type="video/mp4" />
                </video>
                <span class="v-progress" aria-hidden="true"></span>
              </div>
            ))}
          </div>
          <div class="v-fade v-fade-l" aria-hidden="true"></div>
          <div class="v-fade v-fade-r" aria-hidden="true"></div>
        </div>
        <div class="v-divider" aria-hidden="true"></div>
      </section>
    </>
  )}

  <!-- ═══════════ MASONRY ═══════════ -->
  <section class="w-gallery container">
    <div class="w-masonry" data-masonry>
      {normalItems.map((it, i) => (
        <figure
          class={`g-tile ${it.noExpand ? 'no-expand' : ''}`}
          data-type={it.type}
          data-ind={it.ind}
          data-title={it.title}
          data-cat={`${indLabel[it.ind]} · ${medLabel[it.type]}`}
          data-desc={it.desc ?? ''}
          data-src={it.src}
          data-aspect={it.aspect}
          tabindex={it.noExpand ? undefined : 0}
          role={it.noExpand ? undefined : 'button'}
          aria-label={it.noExpand ? undefined : `Open ${it.title}`}
        >
          <div class="g-media" style={it.aspect ? `aspect-ratio: ${it.aspect};` : undefined}>
            {it.type === 'video' ? (
              <>
                <video
                  src={`${it.src}#t=0.1`}
                  poster={it.poster}
                  muted loop playsinline preload="metadata"
                  onerror="this.closest('.g-tile').dataset.broken=''"
                ></video>
                <span class="g-badge"><svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg>Video</span>
                <span class="g-progress" aria-hidden="true"></span>
              </>
            ) : (
              <img src={it.src} alt={`${it.title} — ${medLabel[it.type]}`} loading={i < 12 ? 'eager' : 'lazy'} decoding="async" draggable="false" onerror="this.closest('.g-tile').dataset.broken=''" />
            )}
            <figcaption class="g-cap g-cap-over">
              <span class="g-title">{it.title}</span>
              <span class="g-cat">{indLabel[it.ind]} · {medLabel[it.type]}</span>
            </figcaption>
          </div>
          <div class="g-cap g-cap-below" aria-hidden="true">
            <span class="g-title">{it.title}</span>
            <span class="g-cat">{indLabel[it.ind]} · {medLabel[it.type]}</span>
          </div>
        </figure>
      ))}
    </div>
    {wideItems.length > 0 && (
      <div class="w-wide-list" data-masonry>
        {wideItems.map(it => (
          <figure
            class={`g-tile is-wide ${it.noExpand ? 'no-expand' : ''}`}
            data-type={it.type}
            data-ind={it.ind}
            data-title={it.title}
            data-cat={`${indLabel[it.ind]} · ${medLabel[it.type]}`}
            data-desc={it.desc ?? ''}
            data-src={it.src}
            data-aspect={it.aspect}
            tabindex={it.noExpand ? undefined : 0}
            role={it.noExpand ? undefined : 'button'}
            aria-label={it.noExpand ? undefined : `Open ${it.title}`}
          >
            <div class="g-media" style={it.aspect ? `aspect-ratio: ${it.aspect};` : undefined}>
              <img src={it.src} alt={`${it.title} — ${medLabel[it.type]}`} loading="lazy" decoding="async" draggable="false" onerror="this.closest('.g-tile').dataset.broken=''" />
              <figcaption class="g-cap g-cap-over">
                <span class="g-title">{it.title}</span>
                <span class="g-cat">{indLabel[it.ind]} · {medLabel[it.type]}</span>
              </figcaption>
            </div>
            <div class="g-cap g-cap-below" aria-hidden="true">
              <span class="g-title">{it.title}</span>
              <span class="g-cat">{indLabel[it.ind]} · {medLabel[it.type]}</span>
            </div>
          </figure>
        ))}
      </div>
    )}
  </section>

  <!-- ═══════════ LIGHTBOX ═══════════ -->
  <div class="w-lb" data-lb hidden role="dialog" aria-modal="true" aria-label="Project viewer">
    <div class="w-lb-top">
      <span class="w-lb-pos" data-lb-pos></span>
      <button type="button" class="w-round-btn" data-lb-close aria-label="Close">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </div>
    <div class="w-lb-stage" data-lb-stage>
      <div class="w-lb-media" data-lb-media></div>
    </div>
    <div class="w-lb-info">
      <div class="w-lb-text">
        <p class="w-lb-cat" data-lb-cat></p>
        <p class="w-lb-title" data-lb-title></p>
        <p class="w-lb-desc" data-lb-desc></p>
      </div>
      <div class="w-lb-nav">
        <button type="button" class="w-round-btn" data-lb-prev aria-label="Previous">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="w-round-btn" data-lb-next aria-label="Next">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
  </div>

  <Footer />
  <GetStartedModal />
</BaseLayout>

<script>
  /* ── Filters: medium tabs × industry chips ───────────────────────── */
  const tiles = Array.from(document.querySelectorAll<HTMLElement>('.g-tile'));
  const tabs  = Array.from(document.querySelectorAll<HTMLButtonElement>('.w-tab'));
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.w-chip'));
  const countEl = document.querySelector<HTMLElement>('[data-count]');
  const sect4a  = document.querySelector<HTMLElement>('[data-rail-wrap="4a"]');
  const sect5a  = document.querySelector<HTMLElement>('[data-rail-wrap="5a"]');
  const gallery = document.querySelector<HTMLElement>('.w-gallery');
  // Originals only — captured before cloning for the infinite loop.
  const cards4a = sect4a ? Array.from(sect4a.querySelectorAll<HTMLElement>('.v-card')) : [];
  const cards5a = sect5a ? Array.from(sect5a.querySelectorAll<HTMLElement>('.v-card')) : [];
  // Live view that includes clones, used for applying the industry filter.
  const allRailCards = () => [
    ...(sect4a ? sect4a.querySelectorAll<HTMLElement>('.v-card') : []),
    ...(sect5a ? sect5a.querySelectorAll<HTMLElement>('.v-card') : []),
  ];
  let med = 'all', ind = 'all';
  type Rail = { reset: () => void; refresh: () => void };
  let rail4a: Rail | null = null, rail5a: Rail | null = null;

  const matches = (t: HTMLElement, m: string, i: string) =>
    !('broken' in t.dataset) && (m === 'all' || t.dataset.type === m) && (i === 'all' || t.dataset.ind === i);
  const matchesInd = (c: HTMLElement, i: string) => i === 'all' || c.dataset.ind === i;
  const vidHas = (i: string) => cards4a.some(c => matchesInd(c, i));
  const tileHas = (m: string, i: string) => tiles.some(t => matches(t, m, i));

  const apply = () => {
    for (const t of tiles) {
      // Grid never shows videos now; otherwise match med/ind.
      const effectiveMed = med === 'video' ? 'video' : (med === 'all' ? 'all' : med);
      const ok = med !== 'video' && matches(t, effectiveMed, ind);
      t.hidden = !ok;
    }
    for (const c of allRailCards()) c.hidden = !matchesInd(c, ind);

    const visVid = cards4a.filter(c => !c.hidden).length;
    if (sect4a)  sect4a.hidden  = !(med === 'video' && visVid > 0);
    if (sect5a)  sect5a.hidden  = !(med === 'all'   && visVid > 0);
    if (gallery) gallery.hidden = med === 'video';

    const visTiles = tiles.filter(t => !t.hidden).length;
    const n = med === 'video' ? visVid : med === 'all' ? visTiles + visVid : visTiles;
    if (countEl) countEl.textContent = `${n} ${n === 1 ? 'piece' : 'pieces'}`;

    for (const tab of tabs) {
      const id = tab.dataset.med!;
      const on = id === med;
      tab.classList.toggle('is-active', on);
      tab.setAttribute('aria-selected', String(on));
      const has = id === 'video' ? vidHas(ind)
                : id === 'all'   ? (tileHas('all', ind) || vidHas(ind))
                                 : tileHas(id, ind);
      tab.classList.toggle('is-unavailable', !has);
    }
    for (const c of chips) {
      const id = c.dataset.ind!;
      const on = id === ind;
      c.classList.toggle('is-active', on);
      c.setAttribute('aria-pressed', String(on));
      const has = med === 'video' ? (id === 'all' ? cards4a.length > 0 : vidHas(id))
               : med === 'all'    ? (tileHas('all', id) || vidHas(id))
                                  : tileHas(med, id);
      c.hidden = id !== 'all' && !has;
    }

    const activeRail = med === 'video' ? rail4a : med === 'all' ? rail5a : null;
    if (activeRail) requestAnimationFrame(() => activeRail.reset());
  };

  tabs.forEach(tab => tab.addEventListener('click', () => {
    const next = tab.dataset.med!;
    const has = next === 'video' ? vidHas(ind)
              : next === 'all'   ? (tileHas('all', ind) || vidHas(ind))
                                 : tileHas(next, ind);
    med = next;
    if (!has) ind = 'all';
    apply();
  }));
  chips.forEach(c => c.addEventListener('click', () => { ind = c.dataset.ind!; apply(); }));

  // A tile that fails to load drops out of the grid and the lightbox.
  document.querySelectorAll('[data-masonry]').forEach(root => {
    new MutationObserver(apply).observe(root, { subtree: true, attributes: true, attributeFilter: ['data-broken'] });
  });

  /* ── Video tiles: muted preview on hover (mouse only) ───────────── */
  tiles.filter(t => t.dataset.type === 'video').forEach(t => {
    const v = t.querySelector('video')!;
    t.addEventListener('pointerenter', e => { if (e.pointerType === 'mouse') { v.muted = true; v.play().catch(() => {}); t.classList.add('is-previewing'); } });
    t.addEventListener('pointerleave', () => { v.pause(); v.currentTime = 0.1; t.classList.remove('is-previewing'); });
  });

  /* ── Reveal on scroll ───────────────────────────────────────────── */
  const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
  tiles.forEach(t => io.observe(t));

  /* ── Lightbox ───────────────────────────────────────────────────── */
  const lb      = document.querySelector<HTMLElement>('[data-lb]')!;
  const stage   = document.querySelector<HTMLElement>('[data-lb-stage]')!;
  const mediaEl = document.querySelector<HTMLElement>('[data-lb-media]')!;
  const posEl   = document.querySelector<HTMLElement>('[data-lb-pos]')!;
  const catEl   = document.querySelector<HTMLElement>('[data-lb-cat]')!;
  const titleEl = document.querySelector<HTMLElement>('[data-lb-title]')!;
  const descEl  = document.querySelector<HTMLElement>('[data-lb-desc]')!;
  let list: HTMLElement[] = [];
  let idx = 0;
  let lastFocus: HTMLElement | null = null;

  const pad = (n: number) => String(n).padStart(2, '0');
  // Fit a (w×h) box inside the available viewport, capped to 1280 wide
   // and (viewport - 220) tall. Never upscales past natural size.
   const fit = (w: number, h: number) => {
     const maxW = Math.min(window.innerWidth - 64, 1280);
     const maxH = Math.max(240, window.innerHeight - 220);
     const scale = Math.min(maxW / w, maxH / h, 1);
     mediaEl.style.width  = `${Math.round(w * scale)}px`;
     mediaEl.style.height = `${Math.round(h * scale)}px`;
   };
   let onResize: (() => void) | null = null;
   const unbindResize = () => { if (onResize) { window.removeEventListener('resize', onResize); onResize = null; } };

  const render = () => {
    const t = list[idx]; if (!t) return;
    const src = t.dataset.src!;
    mediaEl.innerHTML = '';
    mediaEl.style.cssText = '';
    unbindResize();
    // Parse aspect ("1920 / 1080") if we already know it (from manifest);
    // otherwise we'll measure once the media's natural size arrives.
    let w = 0, h = 0;
    if (t.dataset.aspect) {
      const [aw, ah] = t.dataset.aspect.split('/').map(s => parseFloat(s.trim()));
      if (aw > 0 && ah > 0) { w = aw; h = ah; fit(w, h); }
    }
    if (t.dataset.type === 'video') {
      const v = document.createElement('video');
      Object.assign(v, { controls: true, autoplay: true, loop: true, playsInline: true });
      const webm = document.createElement('source');
      webm.src = src.replace(/\.mp4$/, '.webm'); webm.type = 'video/webm';
      const mp4 = document.createElement('source');
      mp4.src = src; mp4.type = 'video/mp4';
      v.append(webm, mp4);
      v.addEventListener('loadedmetadata', () => { if (v.videoWidth && v.videoHeight) { w = v.videoWidth; h = v.videoHeight; fit(w, h); } }, { once: true });
      mediaEl.appendChild(v);
    } else {
      const img = document.createElement('img');
      img.src = src; img.alt = t.dataset.title || ''; img.draggable = false;
      const onLoad = () => { if (img.naturalWidth && img.naturalHeight) { w = img.naturalWidth; h = img.naturalHeight; fit(w, h); } };
      if (img.complete && img.naturalWidth) onLoad(); else img.addEventListener('load', onLoad, { once: true });
      mediaEl.appendChild(img);
    }
    // Re-fit on viewport resize so aspect stays correct.
    onResize = () => { if (w && h) fit(w, h); };
    window.addEventListener('resize', onResize);
    mediaEl.classList.remove('is-in'); void mediaEl.offsetWidth; mediaEl.classList.add('is-in');
    posEl.textContent = `${pad(idx + 1)} / ${pad(list.length)}`;
    catEl.textContent = t.dataset.cat || '';
    titleEl.textContent = t.dataset.title || '';
    descEl.textContent = t.dataset.desc || '';
    descEl.hidden = !t.dataset.desc;
    // Preload neighbours
    [list[idx + 1], list[idx - 1]].forEach(n => { if (n && n.dataset.type !== 'video') { const i = new Image(); i.src = n.dataset.src!; } });
  };
  const openAt = (t: HTMLElement, customList?: HTMLElement[]) => {
    list = customList ?? tiles.filter(x => !x.hidden && !x.classList.contains('no-expand'));
    idx = Math.max(0, list.indexOf(t));
    lastFocus = document.activeElement as HTMLElement;
    lb.hidden = false;
    document.body.style.overflow = 'hidden';
    render();
    lb.querySelector<HTMLElement>('[data-lb-close]')?.focus();
  };
  const close = () => {
    lb.hidden = true; mediaEl.innerHTML = '';
    mediaEl.style.cssText = '';
    unbindResize();
    document.body.style.overflow = '';
    lastFocus?.focus();
  };
  const step = (d: number) => { if (!list.length) return; idx = (idx + d + list.length) % list.length; render(); };

  tiles.forEach(t => {
    if (t.classList.contains('no-expand')) return;
    t.addEventListener('click', () => openAt(t));
    t.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openAt(t); } });
  });
  lb.querySelector('[data-lb-close]')?.addEventListener('click', close);
  lb.querySelector('[data-lb-prev]')?.addEventListener('click', () => step(-1));
  lb.querySelector('[data-lb-next]')?.addEventListener('click', () => step(1));
  let justDragged = false;
  lb.addEventListener('click', e => {
    if (justDragged) { justDragged = false; return; }
    if (e.target === lb || e.target === stage) close();
  });
  document.addEventListener('keydown', e => {
    if (lb.hidden) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowRight') step(1);
    else if (e.key === 'ArrowLeft') step(-1);
  });

  // Swipe / drag
  let x0 = 0, dx = 0, dragging = false;
  stage.addEventListener('pointerdown', e => {
    if ((e.target as HTMLElement).closest('video')) return;   // keep native video controls usable
    dragging = true; x0 = e.clientX; dx = 0;
    mediaEl.style.transition = 'none';
    stage.setPointerCapture(e.pointerId);
  });
  stage.addEventListener('pointermove', e => {
    if (!dragging) return;
    dx = e.clientX - x0;
    mediaEl.style.transform = `translateX(${dx}px)`;
  });
  const endDrag = () => {
    if (!dragging) return;
    dragging = false;
    mediaEl.style.transition = '';
    mediaEl.style.transform = '';
    justDragged = Math.abs(dx) > 5;
    if (Math.abs(dx) > 60) step(dx < 0 ? 1 : -1);
  };
  stage.addEventListener('pointerup', endDrag);
  stage.addEventListener('pointercancel', endDrag);

  /* ── Centre-stage rail (shared by 4a + 5a) ──────────────────────── */
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const pad2 = (n: number) => String(n).padStart(2, '0');

  function initRail(section: HTMLElement): Rail {
    const rail = section.querySelector<HTMLElement>('[data-rail]')!;
    const originals = Array.from(rail.querySelectorAll<HTMLElement>('.v-card'));
    const n = originals.length;
    const loop = n > 1;
    // Tag then triple the list so the user can scroll either way without hitting a wall.
    originals.forEach((c, i) => c.dataset.origIdx = String(i));
    if (loop) {
      const copy = () => originals.map(c => {
        const el = c.cloneNode(true) as HTMLElement;
        el.dataset.clone = '1';
        return el;
      });
      rail.prepend(...copy());
      rail.append(...copy());
    }
    const cards = Array.from(rail.querySelectorAll<HTMLElement>('.v-card'));
    const origOf = (c: HTMLElement) => Number(c.dataset.origIdx);
    const copyOf = (c: HTMLElement) => Math.floor(cards.indexOf(c) / n);

    const posEl = section.querySelector<HTMLElement>('.v-pos');
    const titleEl = section.querySelector<HTMLElement>('.v-title');
    const prevBtn = section.querySelector<HTMLButtonElement>('[data-rail-prev]');
    const nextBtn = section.querySelector<HTMLButtonElement>('[data-rail-next]');
    const behavior: ScrollBehavior = reduced ? 'auto' : 'smooth';
    let activeCard: HTMLElement | null = null;
    let activeOrig = -1;
    let teleporting = false;

    const vis = () => cards.filter(c => !c.hidden);
    const centreOf = (c: HTMLElement) => c.offsetLeft + c.offsetWidth / 2 - rail.clientWidth / 2;
    const scrollTo = (c: HTMLElement, behav: ScrollBehavior = behavior) => rail.scrollTo({ left: centreOf(c), behavior: behav });
    const nearest = () => {
      const centre = rail.scrollLeft + rail.clientWidth / 2;
      const v = vis(); if (!v.length) return null;
      let best = v[0], bestD = Infinity;
      for (const c of v) { const d = Math.abs(c.offsetLeft + c.offsetWidth / 2 - centre); if (d < bestD) { bestD = d; best = c; } }
      return best;
    };

    const setActive = (card: HTMLElement) => {
      if (card === activeCard) return;
      const prev = activeCard;
      activeCard = card;
      cards.forEach(c => c.classList.toggle('is-active', c === card));
      const orig = origOf(card);
      const newV = card.querySelector<HTMLVideoElement>('video');
      const prevV = prev?.querySelector<HTMLVideoElement>('video') ?? null;

      if (orig !== activeOrig) {
        activeOrig = orig;
        cards.forEach(c => {
          const vv = c.querySelector<HTMLVideoElement>('video');
          if (!vv) return;
          if (c === card && !reduced) { vv.muted = true; vv.play().catch(() => {}); }
          else { vv.pause(); try { vv.currentTime = 0.1; } catch {} const p = c.querySelector<HTMLElement>('.v-progress'); if (p) p.style.width = '0%'; }
        });
        const vOrigs = originals.filter(c => !c.hidden);
        const rank = vOrigs.findIndex(c => origOf(c) === orig);
        if (posEl)  posEl.textContent  = `${pad2(rank + 1)} / ${pad2(vOrigs.length)}`;
        if (titleEl) titleEl.textContent = card.dataset.title || '';
      } else if (prevV && newV && prevV !== newV) {
        // Same video, different clone (teleport sibling). Preserve playback.
        const t = prevV.currentTime;
        prevV.pause();
        try { newV.currentTime = t; } catch {}
        if (!reduced) { newV.muted = true; newV.play().catch(() => {}); }
      }

      // Non-loop rails dim the end arrows; loop never bottoms out.
      if (!loop) {
        const v = vis(); const i = v.indexOf(card);
        if (prevBtn) prevBtn.style.opacity = i === 0 ? '.35' : '';
        if (nextBtn) nextBtn.style.opacity = i === v.length - 1 ? '.35' : '';
      }

      // Teleport: if we've entered an outer copy, silently warp to the
      // equivalent card in the middle copy so there's always more rail
      // in either direction.
      if (loop && !teleporting) {
        const copy = copyOf(card);
        if (copy !== 1) {
          const sibling = cards[cards.indexOf(card) + (copy === 0 ? n : -n)];
          if (sibling && !sibling.hidden) {
            teleporting = true;
            const t = newV?.currentTime ?? 0.1;
            newV?.pause();
            const sv = sibling.querySelector<HTMLVideoElement>('video');
            if (sv) { try { sv.currentTime = t; } catch {} if (!reduced) { sv.muted = true; sv.play().catch(() => {}); } }
            card.classList.remove('is-active');
            sibling.classList.add('is-active');
            activeCard = sibling;
            rail.scrollTo({ left: rail.scrollLeft + (sibling.offsetLeft - card.offsetLeft), behavior: 'auto' });
            requestAnimationFrame(() => { teleporting = false; });
          }
        }
      }
    };

    let raf = 0;
    rail.addEventListener('scroll', () => {
      if (teleporting || raf) return;
      raf = requestAnimationFrame(() => { raf = 0; const c = nearest(); if (c) setActive(c); });
    });
    window.addEventListener('resize', () => { const c = nearest(); if (c) setActive(c); });

    const stepBy = (dir: number) => {
      if (!activeCard) return;
      let i = cards.indexOf(activeCard) + dir;
      while (i >= 0 && i < cards.length && cards[i].hidden) i += dir;
      if (i < 0 || i >= cards.length) return;
      scrollTo(cards[i]);
    };

    cards.forEach(c => {
      c.addEventListener('click', () => {
        if (c.classList.contains('is-active')) openAt(c, originals.filter(o => !o.hidden));
        else scrollTo(c);
      });
      c.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); (c as HTMLElement).click(); }
      });
      const vv = c.querySelector<HTMLVideoElement>('video');
      const prog = c.querySelector<HTMLElement>('.v-progress');
      if (vv && prog) vv.addEventListener('timeupdate', () => {
        if (vv.duration) prog.style.width = `${(vv.currentTime / vv.duration) * 100}%`;
      });
    });
    prevBtn?.addEventListener('click', () => stepBy(-1));
    nextBtn?.addEventListener('click', () => stepBy(1));
    rail.addEventListener('keydown', e => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); stepBy(-1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); stepBy(1); }
    });

    new IntersectionObserver(es => es.forEach(e => {
      if (!e.isIntersecting) cards.forEach(c => c.querySelector<HTMLVideoElement>('video')?.pause());
      else if (!reduced && activeCard) activeCard.querySelector<HTMLVideoElement>('video')?.play().catch(() => {});
    }), { threshold: 0.1 }).observe(rail);

    const firstVis = () => {
      const v = vis(); if (!v.length) return null;
      return loop ? (v.find(c => copyOf(c) === 1) || v[0]) : v[0];
    };

    return {
      reset: () => {
        const target = firstVis();
        if (!target) { activeCard = null; activeOrig = -1; return; }
        teleporting = true;
        rail.scrollTo({ left: centreOf(target), behavior: 'auto' });
        activeCard = null; activeOrig = -1;
        setActive(target);
        requestAnimationFrame(() => { teleporting = false; });
      },
      refresh: () => { const c = nearest(); if (c) setActive(c); },
    };
  }
  // 5a is visible on All Work (default view); 4a only shows on Videography.
  // Defer 4a's init until first needed to skip 46 cloneNodes + their DOM cost.
  if (sect5a) rail5a = initRail(sect5a);
  const ensure4a = () => { if (sect4a && !rail4a) { rail4a = initRail(sect4a); apply(); } };
  tabs.forEach(tab => { if (tab.dataset.med === 'video') tab.addEventListener('click', ensure4a, { once: true }); });
  apply();

  /* ── Hero mute toggle ───────────────────────────────────────────── */
  const heroVideo = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const heroMute  = document.querySelector<HTMLButtonElement>('[data-hero-mute]');
  if (heroVideo && heroMute) {
    const sync = () => {
      heroMute.setAttribute('aria-pressed', String(heroVideo.muted));
      heroMute.setAttribute('aria-label', heroVideo.muted ? 'Unmute video' : 'Mute video');
    };
    heroMute.addEventListener('click', () => {
      heroVideo.muted = !heroVideo.muted;
      if (!heroVideo.muted) heroVideo.play().catch(() => {});
      sync();
    });
    heroVideo.addEventListener('volumechange', sync);
    sync();
  }
</script>

<style>
  /* ── Page tint (sits over BaseLayout's starfield) ───────────────── */
  .work-page-bg {
    position: fixed; inset: 0; z-index: -1; pointer-events: none;
    background: linear-gradient(180deg, rgba(81,69,155,.16), rgba(107,62,136,.10) 30%, rgba(142,74,93,.10) 60%, rgba(176,74,46,.14));
  }

  /* ── Shared round icon button ───────────────────────────────────── */
  .w-round-btn {
    appearance: none; flex: none;
    width: 52px; height: 52px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    color: #fff; cursor: pointer;
    background: rgba(5,3,8,.55);
    border: 1px solid rgba(255,255,255,.28);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    transition: border-color .2s ease, background .2s ease, transform .2s ease;
  }
  .w-round-btn:hover { border-color: rgba(255,147,23,.7); background: rgba(5,3,8,.75); transform: translateY(-1px); }
  .w-round-btn:active { transform: scale(.96); }
  .w-round-btn:focus-visible { outline: 2px solid #ff9317; outline-offset: 3px; }

  /* ── Hero ───────────────────────────────────────────────────────── */
  .w-hero { position: relative; width: 100%; aspect-ratio: 1920 / 820; min-height: 480px; max-height: 86vh; overflow: hidden; background: #050308; }
  .w-hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .w-hero-shade { position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, rgba(5,3,8,.35), rgba(5,3,8,0) 30%, rgba(5,3,8,0) 55%, rgba(5,3,8,.92)); }
  .w-hero-title {
    position: absolute; left: max(44px, calc((100% - 1400px) / 2 + 44px)); bottom: 48px; margin: 0;
    font-family: 'Madani', sans-serif; font-weight: 900;
    font-size: clamp(64px, 8.9vw, 128px); line-height: .9; letter-spacing: -0.03em;
    color: #fff; pointer-events: none;
  }
  .w-hero-mute { position: absolute; right: max(44px, calc((100% - 1400px) / 2 + 44px)); bottom: 60px; }
  .w-hero-mute .icon-unmuted { display: none; }
  .w-hero-mute[aria-pressed="false"] .icon-muted { display: none; }
  .w-hero-mute[aria-pressed="false"] .icon-unmuted { display: block; }

  /* ── Filters ────────────────────────────────────────────────────── */
  .w-filters { padding-top: 56px; }
  .w-scroll { scrollbar-width: none; }
  .w-scroll::-webkit-scrollbar { display: none; }
  .w-tabs { display: flex; gap: 12px; }
  /* Shared glass base for tabs + chips — matches .cta-btn */
  .w-tab, .w-chip {
    position: relative; isolation: isolate; overflow: hidden;
    flex: none; appearance: none; cursor: pointer; white-space: nowrap;
    display: inline-flex; align-items: center; justify-content: center;
    font-family: 'Madani', sans-serif; line-height: 1;
    color: var(--cream);
    background: rgba(10,7,16,.18);
    border: 1.5px solid rgba(255,255,255,.22);
    border-radius: 999px;
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.22),
      inset 0 -4px 10px rgba(0,0,0,.2),
      0 6px 18px rgba(0,0,0,.3);
    text-shadow: 0 0 8px rgba(0,0,0,.5);
    transition: transform .22s ease, border-color .22s ease, filter .22s ease, opacity .22s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .w-tab { height: 48px; padding: 0 22px; font-weight: 800; font-size: 16px; letter-spacing: -.2px; }
  .w-chip { height: 40px; padding: 0 18px; font-weight: 600; font-size: 14px; }

  .w-tab:hover, .w-chip:hover { transform: translateY(-1px); border-color: rgba(255,255,255,.34); filter: brightness(1.08); }
  .w-tab:active, .w-chip:active { transform: translateY(0) scale(.97); }
  .w-tab:focus-visible, .w-chip:focus-visible { outline: 2px solid var(--orange); outline-offset: 3px; }

  /* Active = animated colour blobs + specular pulse (matches .cta-btn) */
  .w-tab.is-active::before,
  .w-chip.is-active::before {
    content: ""; position: absolute; inset: -60%; z-index: -1;
    background:
      radial-gradient(circle at 20% 50%, var(--ember)  0%, transparent 18%),
      radial-gradient(circle at 70% 30%, var(--orange) 0%, transparent 16%),
      radial-gradient(circle at 60% 80%, var(--violet) 0%, transparent 20%);
    filter: blur(18px) saturate(130%);
    opacity: .7;
    animation: ctaSpin 11s linear infinite;
    mix-blend-mode: screen;
  }
  .w-tab.is-active::after,
  .w-chip.is-active::after {
    content: ""; position: absolute; left: 10%; right: 10%; top: 2px; height: 55%;
    border-radius: 999px;
    background: radial-gradient(ellipse at 50% 0%, rgba(255,255,255,.4), rgba(255,255,255,0) 70%);
    pointer-events: none;
    animation: ctaPulse 3.6s ease-in-out infinite;
  }

  .w-tab.is-unavailable { opacity: .35; filter: grayscale(.4); }
  .w-tab-hint { display: none; }

  .w-chiprow { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-top: 24px; }
  .w-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .w-chip[hidden] { display: none; }
  .w-count { flex: none; font-family: 'Madani', sans-serif; font-weight: 500; font-size: 14px; color: #8a827a; }

  /* ── Masonry ────────────────────────────────────────────────────── */
  .w-gallery { padding-top: 48px; padding-bottom: 140px; }
  .w-masonry { columns: 4; column-gap: 16px; }
  .g-tile {
    position: relative; margin: 0 0 16px; break-inside: avoid;
    opacity: 0; transform: translateY(24px);
    transition: opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1);
  }
  .g-tile.in { opacity: 1; transform: none; }
  .g-tile[hidden], .g-tile[data-broken] { display: none; }
  .g-tile:not(.no-expand) { cursor: zoom-in; }
  .g-tile:focus-visible { outline: none; }
  .g-tile:focus-visible .g-media { outline: 2px solid #ff9317; outline-offset: 3px; }
  /* Wide tiles live in their own flex-column container below the main
     masonry so multicol balancing can't leave an empty gap trying to
     wrap around them. */
  .w-wide-list { display: flex; flex-direction: column; gap: 16px; margin-top: 16px; }
  .g-tile.is-wide { width: 100%; margin: 0; }

  .g-media {
    position: relative; overflow: hidden; border-radius: 14px;
    background: #0e0b10;
    border: 1px solid rgba(255,255,255,.08);
    box-shadow: 0 10px 26px rgba(0,0,0,.4);
    transition: transform .45s cubic-bezier(.2,.7,.2,1), box-shadow .45s ease, border-color .35s ease;
  }
  .g-media img, .g-media video { display: block; width: 100%; height: auto; user-select: none; }
  .g-tile[data-type="video"] .g-media { aspect-ratio: 9 / 16; }
  .g-tile[data-type="video"] video { height: 100%; object-fit: cover; }
  /* Per-item aspect-ratio comes from the inline style on .g-media so
     portrait and landscape clips both show at their true shape. */
  .g-tile[data-aspect] .g-media { aspect-ratio: unset; }
  .g-tile[data-aspect] video { position: absolute; inset: 0; width: 100%; height: 100%; }
  .g-media { position: relative; }

  .g-badge {
    position: absolute; top: 12px; right: 12px;
    display: inline-flex; align-items: center; gap: 6px; height: 30px; padding: 0 12px 0 10px;
    border-radius: 999px; color: #fff;
    background: rgba(5,3,8,.55); border: 1px solid rgba(255,255,255,.25);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    font-family: 'Madani', sans-serif; font-weight: 600; font-size: 12px; line-height: 1;
    pointer-events: none;
  }
  .g-progress { position: absolute; left: 0; top: 0; height: 3px; width: 0; background: #ff9317; pointer-events: none; }
  .g-tile.is-previewing .g-progress { animation: gPrev 6s linear infinite; }
  @keyframes gPrev { from { width: 0; } to { width: 100%; } }

  .g-cap { display: flex; flex-direction: column; gap: 5px; font-family: 'Madani', sans-serif; }
  .g-title { font-weight: 800; font-size: 16px; line-height: 1.2; color: #fff; }
  .g-cat { font-weight: 500; font-size: 12px; line-height: 1.2; color: #ff9317; }
  .g-cap-over {
    position: absolute; left: 12px; right: 12px; bottom: 12px;
    padding: 14px 16px; border-radius: 12px;
    background: rgba(12,10,14,.72); border: 1px solid rgba(255,255,255,.08);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    opacity: 0; transform: translateY(14px);
    transition: opacity .3s ease, transform .45s cubic-bezier(.2,.7,.2,1);
    pointer-events: none;
  }
  .g-cap-below { display: none; }
  .no-expand .g-cap-over { display: none; }

  /* Hover affordances only where a real pointer exists */
  @media (hover: hover) and (pointer: fine) {
    .g-tile:not(.no-expand):hover .g-media {
      transform: translateY(-4px);
      border-color: rgba(255,147,23,.45);
      box-shadow: 0 24px 50px rgba(0,0,0,.55), 0 0 30px rgba(255,120,40,.12);
    }
    .g-tile:hover .g-cap-over { opacity: 1; transform: none; }
  }
