  .photo-grid[data-slide="4"] { grid-template-columns: 1fr 1fr 1fr 1fr; }
  /* Every tile uses a unique gradient placeholder + label so shapes are
     always visible. The <img> layers on top; if it fails, onerror hides it
     and the placeholder + label remain. */
  .ph-tile, .social-tile, .social-wide, .video-tile {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.10);
