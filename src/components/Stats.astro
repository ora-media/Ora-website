---
const stats = [
  { label: 'Brands', value: '+150' },
  { label: 'Views', value: '+120M' },
  { label: 'Content Pieces', value: '+4500' },
  { label: 'Shoots', value: '+400' },
  { label: 'Campaigns', value: '+250' },
];
const topLogos = ['Emirates Red Crescent', 'Sharjah Gov', 'Sharjah Co-op', 'Abu Dhabi TV', 'AIS Sharjah', 'GITEX Global'];
const bottomLogos = ['Kana', 'Mahrosah', 'Yah Oud', 'Low Calories', 'Masar', 'Derma One', 'Bab Alkhozam'];
---
<section class="stats-section">
  <div class="container">
    <div class="reveal stats-row" data-stats>
      {stats.map((s, i) => (
        <div class={`stat ${i === 0 ? 'is-active' : ''}`}>
          <span class="stat-label">{s.label}</span>
          <span class="stat-num">{s.value}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="logos" aria-label="Clients">
    <div class="logo-row"><div class="logo-track logo-track-l">{[...topLogos, ...topLogos].map(l => <span class="logo-slot">{l}</span>)}</div></div>
    <div class="logo-row"><div class="logo-track logo-track-r">{[...bottomLogos, ...bottomLogos].map(l => <span class="logo-slot">{l}</span>)}</div></div>
  </div>
</section>

<style>
  .stats-section { position: relative; z-index: 1; padding: 0 0 calc(var(--section) - 20px); }

  .stats-row {
    display: grid; grid-template-columns: repeat(5, minmax(0, 1fr));
    border-top: 1px solid rgba(255,255,255,.08); border-bottom: 1px solid rgba(255,255,255,.08);
  }
  .stat { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 44px 12px; }
  .stat + .stat { border-left: 1px solid rgba(255,255,255,.08); }
  .stat-label { font-weight: 600; font-size: 16px; line-height: 1; letter-spacing: .3px; color: var(--faint); transition: color .5s ease; white-space: nowrap; }
  .stat-num {
    padding: 0 4px;
    font-family: 'Alumni', sans-serif; font-size: 88px; line-height: 1.1;
    background: linear-gradient(180deg, rgba(240,149,90,.6), rgba(138,61,31,.55));
    -webkit-background-clip: text; background-clip: text; color: transparent;
    transform: scale(.9);
    transition: transform .6s cubic-bezier(.34,1.25,.5,1);
  }
  .stat.is-active .stat-label { color: #efe7de; }
  .stat.is-active .stat-num { background-image: linear-gradient(180deg, #ffb066, #c25a26); transform: scale(1.08); }

  .logos { display: flex; flex-direction: column; gap: 12px; margin-top: 72px; }
  .logo-row {
    overflow: hidden; padding: 18px 0;
    background: linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.015));
    border-top: 1px solid rgba(255,255,255,.05);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
            mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .logo-track { display: flex; width: max-content; }
  .logo-track-l { animation: marqueeL 42s linear infinite; }
  .logo-track-r { animation: marqueeR 42s linear infinite; }
  .logo-slot { flex: none; padding: 0 44px; font-weight: 600; font-size: 15px; line-height: 44px; letter-spacing: .3px; color: #cfc7be; opacity: .8; white-space: nowrap; }

  @media (max-width: 1199px) { .stat-num { font-size: 70px; } }
  @media (max-width: 899px) {
    .stat { padding: 32px 6px; }
    .stat-label { font-size: 14px; letter-spacing: .2px; }
    .stat-num { font-size: 54px; }
  }
  /* Phones: swipeable cards */
  @media (max-width: 599px) {
    .stats-section .container { padding: 0; }
    .stats-row {
      display: flex; gap: 10px; overflow-x: auto; scroll-snap-type: x mandatory;
      padding: 0 var(--gutter) 4px; border: 0; scrollbar-width: none;
    }
    .stats-row::-webkit-scrollbar { display: none; }
    .stat, .stat + .stat {
      flex: none; width: 150px; scroll-snap-align: start;
      align-items: flex-start; gap: 8px; padding: 20px 18px;
      border-radius: 16px; border: 1px solid rgba(255,255,255,.08);
      background: rgba(255,255,255,.025);
      transition: background .5s ease;
    }
    .stat.is-active { background: linear-gradient(180deg, rgba(255,138,58,.12), rgba(255,255,255,.02)); }
    .stat-label { font-size: 14px; }
    .stat-num { font-size: 60px; padding: 0 2px; transform: none !important; }
    .logos { gap: 8px; margin-top: 44px; }
    .logo-row { padding: 10px 0; -webkit-mask-image: none; mask-image: none; background: rgba(255,255,255,.04); }
    .logo-track-l, .logo-track-r { animation-duration: 36s; }
    .logo-slot { padding: 0 24px; font-size: 13px; line-height: 36px; }
  }
</style>

<script>
  // Cycle the highlighted stat once the row is on screen.
  const row = document.querySelector<HTMLElement>('[data-stats]');
  if (row) {
    const items = Array.from(row.querySelectorAll<HTMLElement>('.stat'));
    let i = 0, timer: number | null = null, paused = false;
    row.addEventListener('mouseenter', () => { paused = true; });
    row.addEventListener('mouseleave', () => { paused = false; });
    const step = () => {
      if (paused) return;
      i = (i + 1) % items.length;
      items.forEach((n, k) => n.classList.toggle('is-active', k === i));
    };
    new IntersectionObserver((es, io) => {
      if (es.some(e => e.isIntersecting)) { window.setTimeout(step, 600); timer = window.setInterval(step, 2600); io.disconnect(); }
    }, { threshold: 0.25 }).observe(row);
    window.addEventListener('beforeunload', () => { if (timer) window.clearInterval(timer); });
  }
</script>
