---
import OraLogo from './OraLogo.astro';
// Some items scroll to a section on the home page ("scroll"); others navigate
// to a dedicated page ("href"). Labels/order stay identical either way.
const items = [
  { id: 'who',  label: 'Who We Are', type: 'scroll' as const },
  { id: 'do',   label: 'What We Do', type: 'scroll' as const },
  { id: 'work', label: 'Work',       type: 'href'   as const, href: '/work' },
];
const currentPath = Astro.url.pathname;
---
<nav class="site-nav no-print">
  <a class="nav-logo" href="/" aria-label="Ora — home"><OraLogo height={40} /></a>

  <div class="nav-links">
    {items.map(it => (
      it.type === 'href'
        ? <a class={`nav-pill ${currentPath === it.href ? 'is-active' : ''}`} data-nav-link={it.id} href={it.href}>{it.label}</a>
        : <button class="nav-pill" data-nav-link={it.id} data-scroll={it.id} data-scroll-home>{it.label}</button>
    ))}
  </div>

  <div class="nav-right">
    <button class="cta-btn nav-cta" data-open-modal>Get Started</button>
    <button class="nav-burger" aria-label="Open menu" aria-expanded="false" data-burger>
      <span></span><span></span>
    </button>
  </div>
</nav>

<!-- Mobile menu (<768px) -->
<div class="nav-menu no-print" data-menu aria-hidden="true">
  <div class="nav-menu-links">
    {items.map(it => (
      it.type === 'href'
        ? <a class="nav-menu-link" href={it.href}>{it.label}<span aria-hidden="true">→</span></a>
        : <button class="nav-menu-link" data-scroll={it.id} data-scroll-home>{it.label}<span aria-hidden="true">→</span></button>
    ))}
  </div>
  <div class="nav-menu-foot">
    <button class="cta-btn lg nav-menu-cta" data-open-modal>Get Started</button>
    <div class="nav-menu-contact">
      <a href="mailto:info@oramedia.net">info@oramedia.net</a>
      <a href="tel:+971556370357">+971 55 637 0357</a>
    </div>
  </div>
</div>

<style>
  .site-nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 60;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    padding: 28px var(--gutter);
    background: linear-gradient(180deg, rgba(5,3,8,.85), rgba(5,3,8,0));
    opacity: 0;
    transition: opacity .5s ease .05s, transform .35s var(--ease);
    will-change: transform;
  }
  .site-nav.is-ready { opacity: 1; }
  .site-nav.is-hidden { transform: translateY(-110%); }
  .nav-logo { justify-self: start; display: flex; align-items: center; }

  .nav-links {
    display: flex; gap: 6px; padding: 6px; border-radius: 999px;
    background: rgba(5,3,8,.4);
    border: 1px solid rgba(255,255,255,.08);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  }
  .nav-pill {
    appearance: none; border: 0; background: transparent; cursor: pointer;
    display: flex; align-items: center; height: 40px; padding: 0 20px;
    border-radius: 999px; white-space: nowrap;
    font-family: 'Madani', sans-serif; font-weight: 600; font-size: 15px; line-height: 1;
    color: rgba(213,205,196,.9);
    transition: background .25s ease, color .2s ease;
  }
  .nav-pill:hover { background: rgba(255,255,255,.08); color: #fff; }
  .nav-pill:focus-visible { outline: 2px solid var(--orange); outline-offset: 2px; }
  .nav-pill.is-active {
    color: #fff;
    background: linear-gradient(180deg, #4c4844, #201d1a);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.24), inset 0 -3px 7px rgba(0,0,0,.6);
  }

  .nav-right { justify-self: end; display: flex; align-items: center; gap: 8px; }
  .nav-burger {
    display: none; position: relative;
    width: 44px; height: 44px; border-radius: 999px; cursor: pointer;
    border: 1px solid rgba(255,255,255,.12); background: rgba(5,3,8,.4);
  }
  .nav-burger span {
    position: absolute; left: 13px; right: 13px; height: 2px; border-radius: 2px; background: var(--cream);
    transition: transform .3s ease, top .3s ease;
  }
  .nav-burger span:nth-child(1) { top: 17px; }
  .nav-burger span:nth-child(2) { top: 25px; }
  .nav-burger.is-open span:nth-child(1) { top: 21px; transform: rotate(45deg); }
  .nav-burger.is-open span:nth-child(2) { top: 21px; transform: rotate(-45deg); }

  /* Mobile full-screen menu */
  .nav-menu {
    position: fixed; inset: 0; z-index: 55;
    display: flex; flex-direction: column;
    padding: 104px var(--gutter) 32px;
    background: rgba(5,3,8,.97);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    opacity: 0; transform: translateY(-8px); pointer-events: none;
    transition: opacity .3s ease, transform .35s var(--ease);
  }
  .nav-menu.is-open { opacity: 1; transform: none; pointer-events: auto; }
  .nav-menu-links { display: flex; flex-direction: column; }
  .nav-menu-link {
    appearance: none; background: none; border: 0; border-bottom: 1px solid rgba(255,255,255,.08);
    display: flex; align-items: center; justify-content: space-between;
    min-height: 72px; padding: 0; cursor: pointer; text-align: left;
    font-family: 'Madani', sans-serif; font-weight: 800; font-size: 34px; letter-spacing: -1px;
    color: var(--cream);
  }
  .nav-menu-link span { font-size: 20px; color: var(--orange); }
  .nav-menu-foot { margin-top: auto; display: flex; flex-direction: column; gap: 18px; }
  .nav-menu-cta { width: 100%; height: 56px; }
  .nav-menu-contact { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
  .nav-menu-contact a { padding: 14px 0; font-weight: 500; font-size: 15px; color: var(--body); }

  @media (max-width: 899px) {
    .site-nav { padding: 20px var(--gutter); }
    .nav-pill { padding: 0 14px; font-size: 14px; }
  }
  @media (max-width: 767px) {
    .site-nav { display: flex; padding: 16px 16px 16px 20px; }
    .nav-logo { margin-right: auto; }
    .nav-logo :global(svg) { height: 30px !important; }
    .nav-links { display: none; }
    .nav-burger { display: block; }
    .nav-cta { height: 44px; padding: 0 16px; font-size: 14px; }
  }
  @media (min-width: 768px) { .nav-menu { display: none; } }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('.site-nav');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const linkEls = Array.from(document.querySelectorAll<HTMLElement>('.nav-links [data-nav-link]'));
  const scrollLinkEls = linkEls.filter(el => el.hasAttribute('data-scroll'));
  const sectionIds = scrollLinkEls.map(el => el.dataset.scroll!).filter(Boolean);
  const onHome = () => window.location.pathname === '/' || window.location.pathname === '';

  const setMenu = (open: boolean) => {
    menu?.classList.toggle('is-open', open);
    menu?.setAttribute('aria-hidden', String(!open));
    burger?.classList.toggle('is-open', open);
    burger?.setAttribute('aria-expanded', String(open));
    burger?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) nav?.classList.remove('is-hidden');
  };
  burger?.addEventListener('click', () => setMenu(!menu?.classList.contains('is-open')));
  menu?.querySelectorAll('[data-open-modal]').forEach(b => b.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', e => { if (e.key === 'Escape') setMenu(false); });

  document.querySelectorAll<HTMLElement>('[data-scroll]').forEach(el => {
    el.addEventListener('click', ev => {
      const id = el.dataset.scroll!;
      setMenu(false);
      if (!onHome() && el.hasAttribute('data-scroll-home')) {
        ev.preventDefault();
        window.location.href = id === 'top' ? '/' : `/#${id}`;
        return;
      }
      (window as any).oraScrollTo?.(id);
    });
  });

  if (window.location.hash && onHome()) {
    const id = window.location.hash.slice(1);
    requestAnimationFrame(() => (window as any).oraScrollTo?.(id));
  }

  const updateActive = () => {
    if (!onHome()) return;
    const probe = window.scrollY + 140;
    let cur: string | null = null;
    for (const id of sectionIds) {
      const el = document.getElementById(id);
      if (el && el.getBoundingClientRect().top + window.scrollY <= probe) cur = id;
    }
    for (const el of scrollLinkEls) el.classList.toggle('is-active', el.dataset.scroll === cur);
  };

  requestAnimationFrame(() => nav?.classList.add('is-ready'));
  const SHOW_ABOVE = 80, SLOP = 6;
  let lastY = window.scrollY;
  const updateNavVisibility = () => {
    if (!nav || menu?.classList.contains('is-open')) return;
    const y = window.scrollY, delta = y - lastY;
    if (Math.abs(delta) < SLOP) return;
    if (y < SHOW_ABOVE) nav.classList.remove('is-hidden');
    else nav.classList.toggle('is-hidden', delta > 0);
    lastY = y;
  };

  let ticking = false;
  window.addEventListener('scroll', () => {
    if (ticking) return; ticking = true;
    requestAnimationFrame(() => { ticking = false; updateActive(); updateNavVisibility(); });
  }, { passive: true });
  updateActive();
</script>
