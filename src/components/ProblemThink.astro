---
const problemPoints = [
  'Content being created just to "stay active"',
  "Shoots that look good but don't say anything",
  'Social media handled with no clear direction',
  'Ads running without a real plan',
];
const thinkPoints = [
  'What are you trying to achieve?',
  "What's actually working?",
  'Where are you losing attention?',
];
---
<section id="problem" class="pt-section">
  <div class="container">
    <div class="pt-stack">
      <article class="pt-view is-active" data-view="problem">
        <div class="pt-grid">
          <div class="pt-head">
            <h2 class="h2">The Problem</h2>
            <button class="cta-btn" data-switch>How We Think <span class="arrow">→</span></button>
          </div>
          <div class="pt-body">
            <p class="pt-lead">We've seen this a lot:</p>
            <ul class="pt-list">{problemPoints.map(p => <li><span class="pt-dot"></span>{p}</li>)}</ul>
          </div>
        </div>
        <div class="pt-punch">
          <p class="pt-punch-a">Everything is happening…</p>
          <p class="pt-punch-b">but nothing is really moving.</p>
        </div>
      </article>

      <article class="pt-view" data-view="think" aria-hidden="true">
        <div class="pt-grid">
          <div class="pt-head">
            <h2 class="h2">How We Think</h2>
            <button class="cta-btn" data-switch><span class="arrow">←</span> The Problem</button>
          </div>
          <div class="pt-body">
            <p class="pt-lead">We look at:</p>
            <ul class="pt-list">{thinkPoints.map(p => <li><span class="pt-dot"></span>{p}</li>)}</ul>
          </div>
        </div>
        <div class="pt-punch">
          <p class="pt-punch-b">Then we build from there.</p>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .pt-section { position: relative; padding: var(--section) 0; overflow: hidden; }
  .pt-stack { display: grid; }
  .pt-view {
    grid-area: 1 / 1;
    opacity: 0; transform: translateY(14px); pointer-events: none;
    transition: opacity .55s var(--ease), transform .55s var(--ease);
  }
  .pt-view.is-active { opacity: 1; transform: none; pointer-events: auto; transition-delay: .08s; }

  .pt-grid { display: grid; grid-template-columns: 5fr 7fr; gap: 80px; align-items: start; }
  .pt-head { display: flex; flex-direction: column; align-items: flex-start; gap: 32px; }
  .pt-body { padding-top: 14px; }
  .pt-lead { margin: 0 0 28px; font-weight: 500; font-size: 20px; line-height: 1.4; color: #cfc7be; }
  .pt-list { list-style: none; margin: 0; padding: 0; }
  .pt-list li {
    display: flex; align-items: center; gap: 18px; padding: 20px 0;
    border-top: 1px solid rgba(255,255,255,.07);
    font-weight: 400; font-size: 21px; line-height: 1.4; color: var(--body);
  }
  .pt-dot {
    flex: none; width: 12px; height: 12px; border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #ffcf9c, #b8532a);
    box-shadow: 0 0 12px rgba(223,84,53,.6);
  }
  .pt-punch { margin-top: 120px; }
  .pt-punch p { margin: 0; font-size: clamp(30px, 3.9vw, 56px); line-height: 1.1; letter-spacing: -0.02em; }
  .pt-punch-a { font-weight: 400; color: var(--muted); margin-bottom: 8px !important; }
  .pt-punch-b { font-weight: 700; color: var(--ember); }

  @media (max-width: 1199px) { .pt-grid { gap: 48px; } .pt-punch { margin-top: 88px; } }
  @media (max-width: 899px) {
    .pt-grid { grid-template-columns: 1fr; gap: 36px; }
    .pt-body { padding-top: 0; }
    .pt-punch { margin-top: 72px; }
  }
  @media (max-width: 599px) {
    .pt-head { gap: 20px; }
    .pt-lead { margin-bottom: 8px; font-size: 17px; }
    .pt-list li { gap: 14px; padding: 16px 0; font-size: 17px; }
    .pt-dot { width: 10px; height: 10px; }
    .pt-punch { margin-top: 56px; }
  }
</style>

<script>
  const views = Array.from(document.querySelectorAll<HTMLElement>('#problem [data-view]'));
  document.querySelectorAll<HTMLButtonElement>('#problem [data-switch]').forEach(btn => {
    btn.addEventListener('click', () => {
      const cur = views.find(v => v.classList.contains('is-active'))?.dataset.view;
      const next = cur === 'problem' ? 'think' : 'problem';
      for (const v of views) {
        const on = v.dataset.view === next;
        v.classList.toggle('is-active', on);
        v.setAttribute('aria-hidden', String(!on));
      }
      views.find(v => v.dataset.view === next)?.querySelector<HTMLButtonElement>('[data-switch]')?.focus({ preventScroll: true });
    });
  });
</script>
