---
// Hero — title + subtitle + CTA left, astronaut on the ring's right shoulder,
// retro objects floating around it. Scroll-scrubbed intro is kept as-is.
const objects = [
  { id: 'obj1', l: 44, t: 70, w: 170, h: 125, anim: 'floatA 6.5s ease-in-out infinite',   src: '/images/retro-keyboard.png', alt: 'Retro keyboard', fx: -14, fy:  22, s: 0,    e: 0.5  },
  { id: 'obj2', l: 49, t: 47, w:  96, h: 116, anim: 'floatB 7.5s ease-in-out infinite',   src: '/images/retro-floppy.png',   alt: 'Floppy disk',    fx: -18, fy: -12, s: 0.08, e: 0.58 },
  { id: 'obj3', l: 60, t: 83, w: 130, h:  95, anim: 'floatC 8s ease-in-out infinite',     src: '/images/retro-paper1.png',   alt: 'Paper',          fx:  10, fy:  24, s: 0.15, e: 0.65 },
  { id: 'obj4', l: 85, t: 44, w: 100, h: 115, anim: 'floatA 7s ease-in-out infinite .8s', src: '/images/retro-paper2.png',   alt: 'Paper',          fx:  20, fy: -10, s: 0.2,  e: 0.7  },
];
const RING_D = "M261.99,1412.28c-34.91-124.66-36.59-249.98-4.03-375.01,49.12-188.61,155.36-337.83,319.61-442.6,202.42-129.12,420.36-156.98,648.61-82.58,165.08,53.81,296.55,155.37,387.05,304.09,140.64,231.13,150.84,471.21,34.68,714.98-60.87,127.74-154.71,227.77-275.12,302.34-20.92,12.95-43.02,24-64.51,36.04-3.31,1.86-6.27,4.34-9.39,6.54-28.68,11.56-57.35,23.13-86.03,34.69-17.84,4.63-35.68,9.25-53.52,13.88-116.43,30.17-233.54,32.19-350.56,5.23-190.54-43.9-341.33-147.14-451.41-308.83-17.28-25.38-30.72-53.35-46.04-80.07-1.48-2.59-3.7-4.76-5.57-7.12-11.85-29.4-23.71-58.79-35.56-88.19-2.72-11.13-5.11-22.34-8.2-33.37ZM1065.92,1590.61c168.94-40.19,290.55-178.69,306.47-349.55,4.56-48.87-.63-96.97-14.65-143.95-60.33-202.17-268.06-312.85-464.36-266.32-159.02,37.7-275.13,161.9-302.37,317.23-12.67,72.28-5.73,142.88,24.89,213.86,65.39,172.18,261.51,273.57,450.02,228.72Z";
---
<div id="heroScroll" class="hero-scroll">
  <section id="hero" class="hero">
    <div aria-hidden="true" class="hero-glow"></div>

    <!-- Ring: the mask lives on the padded wrapper so the drop-shadow glow can
         fade out fully instead of being clipped to the SVG box. -->
    <div aria-hidden="true" class="hero-o">
      <svg viewBox="0 420 1920 1074" preserveAspectRatio="xMidYMid meet">
        <defs>
          <linearGradient id="oraCol" x1="0" y1="0" x2="1" y2="1" gradientUnits="objectBoundingBox">
            <stop offset="0" stop-color="#51459b"/><stop offset="0.25" stop-color="#df5435"/><stop offset="0.5" stop-color="#ff9317"/><stop offset="0.75" stop-color="#df5435"/><stop offset="1" stop-color="#51459b"/>
            <animateTransform attributeName="gradientTransform" type="rotate" from="0 0.5 0.5" to="360 0.5 0.5" dur="14s" repeatCount="indefinite"/>
          </linearGradient>
          <filter id="oraGlowBlur" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="26"/></filter>
        </defs>
        <path fill="url(#oraCol)" fill-rule="evenodd" d={RING_D}/>
        <path class="hero-ring-light" fill="none" stroke="url(#oraCol)" stroke-width="42" stroke-linecap="round" pathLength="1000" stroke-dasharray="180 820" filter="url(#oraGlowBlur)" style="mix-blend-mode:screen;" d={RING_D.split('Z')[0] + 'Z'}/>
      </svg>
    </div>

    <div class="hero-copy">
      <h1 class="hero-title">Not Just<br />Content</h1>
      <p class="hero-sub">Most brands today are posting, shooting, boosting…<br />but still not growing.<br />That&rsquo;s where we come in.</p>
      <button class="cta-btn lg hero-cta" data-open-modal>Get Started</button>
    </div>

    {objects.map((o) => (
      <div class={`hero-obj hero-${o.id}`} data-scrub data-s={o.s} data-e={o.e} data-l={o.l} data-t={o.t} data-fx-vw={o.fx} data-fy-vh={o.fy} style={`width:${o.w}px;height:${o.h}px;`}>
        <div class="hero-obj-float" style={`animation:${o.anim};`}>
          <img src={o.src} alt={o.alt} loading="eager" />
        </div>
      </div>
    ))}

    <div id="hs-mascot" class="hero-mascot" data-scrub data-s="0.25" data-e="0.92">
      <div class="hero-mascot-bob">
        <img src="/images/astronaut.webp" alt="Ora astronaut mascot" loading="eager" fetchpriority="high" width="953" height="1093" decoding="async" />
      </div>
    </div>
  </section>
</div>

<style>
  .hero-scroll { position: relative; z-index: 1; height: 240vh; }
  /* Fade the whole hero to transparent so it dissolves into the page tint
     (no solid black band). */
  .hero {
    position: sticky; top: 0; z-index: 1; height: 100vh; height: 100svh; overflow: hidden;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 66%, rgba(0,0,0,.5) 86%, transparent 100%);
            mask-image: linear-gradient(180deg, #000 0%, #000 66%, rgba(0,0,0,.5) 86%, transparent 100%);
  }
  .hero-glow {
    position: absolute; z-index: 1; left: 50%; top: 118%; transform: translate(-50%,-50%);
    width: min(150vw, 1500px); aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle, rgba(255,120,40,.30), rgba(223,84,53,.12) 42%, transparent 62%);
    pointer-events: none;
  }

  /* SVG = 100vw wide (aspect 1920/1074). Wrapper adds 140px padding on every
     side; the mask fades the lower half of the ring out. */
  .hero-o {
    position: absolute; z-index: 2;
    left: -140px; right: -140px;
    bottom: calc(-13.2vw - 140px);
    padding: 140px;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 43%, rgba(0,0,0,.55) 56%, rgba(0,0,0,.15) 65%, transparent 71%);
            mask-image: linear-gradient(180deg, #000 0%, #000 43%, rgba(0,0,0,.55) 56%, rgba(0,0,0,.15) 65%, transparent 71%);
    animation: oraRingHalf 1.2s cubic-bezier(.22,.75,.25,1) both;
  }
  .hero-o svg { display: block; width: 100%; height: auto; aspect-ratio: 1920 / 1074; overflow: visible; filter: drop-shadow(0 0 55px rgba(255,120,40,.45)); }
  @keyframes oraRingHalf { 0% { opacity: 0; transform: translateY(12%) scale(.9); } 55% { opacity: 1; } 100% { opacity: 1; transform: none; } }
  .hero-ring-light { animation: cometMoveR 14s linear infinite; }

  .hero-copy {
    position: absolute; z-index: 5; left: 0; right: 0; top: 0;
    max-width: 1440px; margin: 0 auto;
    padding: clamp(140px, 22vh, 212px) var(--gutter) 0;
    pointer-events: none;
    animation: fadeUp 1s var(--ease) .1s both;
  }
  .hero-title {
    margin: 0; color: #fff;
    font-family: 'Madani'; font-weight: 900;
    font-size: clamp(60px, 8.9vw, 128px); line-height: .96; letter-spacing: -0.028em;
    text-shadow: 0 4px 40px rgba(0,0,0,.6);
  }
  .hero-sub {
    margin: 36px 0 0; max-width: 400px;
    font-family: 'Madani'; font-weight: 400; font-size: 20px; line-height: 1.6;
    color: #d8d0c7; text-shadow: 0 2px 20px rgba(0,0,0,.8); text-wrap: pretty;
  }
  .hero-cta { margin-top: 40px; pointer-events: auto; }

  .hero-obj { position: absolute; z-index: 5; opacity: 0; will-change: transform, opacity; }
  .hero-obj img { width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 6px 20px rgba(0,0,0,.5)); }
  .hero-obj-float { width: 100%; height: 100%; }

  .hero-mascot {
    position: absolute; z-index: 4;
    right: 10.4%; bottom: 4%;
    width: min(28vw, 400px); aspect-ratio: 953 / 1093;
    opacity: 0; transform: translate(0, 120px) scale(.9);
    will-change: transform, opacity;
  }
  .hero-mascot-bob { width: 100%; height: 100%; animation: bob 6s ease-in-out infinite; }
  .hero-mascot img { width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 30px 60px rgba(0,0,0,.55)); }

  /* 900–1199 */
  @media (max-width: 1199px) {
    .hero-sub { font-size: 19px; }
    .hero-mascot { right: 5.5%; width: min(31vw, 320px); }
  }
  /* 600–899 */
  @media (max-width: 899px) {
    .hero-mascot { right: 5%; bottom: 6%; width: min(35vw, 270px); }
  }
  /* <600 */
  @media (max-width: 599px) {
    .hero-scroll { height: 200vh; }
    .hero { -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 68%, rgba(0,0,0,.5) 86%, transparent 100%);
                    mask-image: linear-gradient(180deg, #000 0%, #000 68%, rgba(0,0,0,.5) 86%, transparent 100%); }
    .hero-copy { padding-top: 124px; }
    .hero-title { font-size: clamp(52px, 16.4vw, 64px); letter-spacing: -2px; line-height: .95; }
    .hero-sub { margin-top: 22px; font-size: 17px; line-height: 1.55; max-width: none; }
    .hero-cta { display: none; }   /* CTA lives in the header on phones */
    /* Ring: 180vw wide, centered */
    .hero-o { left: calc(-40vw - 100px); right: calc(-40vw - 100px); padding: 100px; bottom: calc(-28vw - 100px); }
    .hero-o svg { filter: drop-shadow(0 0 40px rgba(255,120,40,.45)); }
    .hero-mascot { right: 50%; margin-right: -28vw; width: 56vw; bottom: 7%; }
    .hero-obj3, .hero-obj4 { display: none; }
  }
</style>

<script>
  // Scroll-scrubbed hero intro (unchanged behaviour).
  const heroScroll = document.getElementById('heroScroll');
  const scrubEls = Array.from(document.querySelectorAll<HTMLElement>('[data-scrub]'));
  if (heroScroll && scrubEls.length) {
    const clamp = (v: number, a: number, b: number) => v < a ? a : v > b ? b : v;
    const smooth = (t: number) => t * t * (3 - 2 * t);
    type C = { el: HTMLElement; s: number; e: number; fx: number; fy: number; isMascot: boolean };
    let cached: C[] | null = null;
    const isPhone = () => window.matchMedia('(max-width: 599px)').matches;

    const cache = () => {
      cached = scrubEls.map(el => {
        const s = parseFloat(el.dataset.s || '0');
        const e = parseFloat(el.dataset.e || '1');
        const isMascot = el.id === 'hs-mascot';
        if (!isMascot) {
          el.style.left = parseFloat(el.dataset.l || '50').toFixed(1) + '%';
          el.style.top  = parseFloat(el.dataset.t || '50').toFixed(1) + '%';
        }
        return { el, s, e, fx: isMascot ? 0 : parseFloat(el.dataset.fxVw || '0'), fy: isMascot ? 120 : parseFloat(el.dataset.fyVh || '0'), isMascot };
      });
    };
    cache();

    const scrub = () => {
      if (!cached) return;
      const total = heroScroll.offsetHeight - window.innerHeight;
      const p = clamp(total > 0 ? -heroScroll.getBoundingClientRect().top / total : 0, 0, 1);
      const objScale = isPhone() ? 0.55 : window.matchMedia('(max-width: 899px)').matches ? 0.75 : 1;
      for (const c of cached) {
        const t = smooth(clamp((p - c.s) / (c.e - c.s), 0, 1));
        const sc = ((c.isMascot ? 0.9 : 0.55) * (1 - t) + t) * (c.isMascot ? 1 : objScale);
        c.el.style.opacity = t.toFixed(3);
        c.el.style.transform = c.isMascot
          ? `translate(0px, ${(c.fy * (1 - t)).toFixed(1)}px) scale(${sc.toFixed(3)})`
          : `translate(${(c.fx * (1 - t)).toFixed(2)}vw, ${(c.fy * (1 - t)).toFixed(2)}vh) scale(${sc.toFixed(3)})`;
      }
    };

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (ticking) return; ticking = true;
      requestAnimationFrame(() => { ticking = false; scrub(); });
    }, { passive: true });
    window.addEventListener('resize', () => { cache(); scrub(); });
    scrub();
  }
</script>
