---
import OraLogo from './OraLogo.astro';
---
<footer id="about" class="site-footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <OraLogo height={54} />
      <p class="footer-tag">Content, strategy and growth built as one system. Let's make something that actually moves.</p>
    </div>
    <div class="footer-cta">
      <div class="footer-contact">
        <a href="mailto:info@oramedia.net">info@oramedia.net</a>
        <a href="tel:+971556370357">+971 55 637 0357</a>
      </div>
      <button class="cta-btn lg" data-open-modal>Get Started</button>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© 2026 Ora Digital Media. All rights reserved.</span>
    <span>Sharjah · Abu Dhabi · UAE</span>
  </div>
</footer>

<style>
  .site-footer {
    position: relative; z-index: 1;
    padding: 100px 0 44px;
    border-top: 1px solid rgba(255,255,255,.06);
    background: linear-gradient(180deg, rgba(255,255,255,0), rgba(223,84,53,.05));
  }
  .footer-top { display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; }
  .footer-tag { margin: 20px 0 0; max-width: 360px; font-weight: 400; font-size: 17px; line-height: 1.6; color: var(--muted); }
  .footer-cta { display: flex; align-items: center; gap: 32px; }
  .footer-contact { display: flex; flex-direction: column; align-items: flex-end; gap: 10px; }
  .footer-contact a { font-weight: 500; font-size: 17px; line-height: 1; color: var(--body); transition: color .2s ease; }
  .footer-contact a:hover { color: var(--orange); }
  .footer-bottom {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px 24px;
    margin-top: 64px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,.06);
    font-weight: 400; font-size: 14px; line-height: 1.4; color: var(--faint);
  }

  @media (max-width: 1199px) { .site-footer { padding: 80px 0 40px; } }
  @media (max-width: 899px) {
    .site-footer { padding: 72px 0 36px; }
    .footer-top { flex-direction: column; align-items: flex-start; gap: 36px; }
    .footer-contact { align-items: flex-start; }
  }
  @media (max-width: 599px) {
    .site-footer { padding: 64px 0 32px; }
    .footer-brand :global(svg) { height: 44px !important; }
    .footer-tag { margin: 18px 0 0; font-size: 16px; }
    .footer-top { gap: 32px; }
    .footer-cta { flex-direction: column-reverse; align-items: stretch; gap: 16px; width: 100%; }
    .footer-cta .cta-btn { width: 100%; height: 56px; }
    .footer-contact { gap: 0; }
    .footer-contact a { display: flex; align-items: center; min-height: 48px; font-size: 16px; border-bottom: 1px solid rgba(255,255,255,.06); }
    .footer-bottom { flex-direction: column; margin-top: 28px; padding-top: 0; border-top: 0; font-size: 13px; }
  }
</style>
