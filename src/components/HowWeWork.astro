---
// ≥900px: snake path that draws on scroll, stops light up as it passes.
// <900px: vertical timeline (line + dots), lights up per stop as you scroll.
const STAGE_W = 1000;
const STAGE_H = 1250;
const stops = [
  { title: 'Understand', l1: 'We take time to understand the', l2: 'brand, not just the brief',     x: 780, y: 340,  textSide: 'right', threshold: 0.24 },
  { title: 'Plan',       l1: 'We put structure behind the',    l2: 'content',                       x: 220, y: 610,  textSide: 'left' , threshold: 0.50 },
  { title: 'Create',     l1: 'We produce content that',        l2: 'actually represents the brand', x: 780, y: 880,  textSide: 'right', threshold: 0.76 },
  { title: 'Improve',    l1: 'We adjust, test, and build on',  l2: 'what works',                    x: 460, y: 1140, textSide: 'left',  threshold: 0.98 },
];
const SNAKE_D = `M 540 -60 C 540 160, 780 200, 780 340 C 780 470, 220 480, 220 610 C 220 740, 780 750, 780 880 C 780 1010, 460 1010, 460 1140`;
---
<section id="process" class="hw">
  <div class="hw-head">
    <div class="hw-group">
      <div class="hw-sun-halo" aria-hidden="true"></div>
      <div class="hw-sun" aria-hidden="true"></div>
      <h2 class="hw-title">How We Work</h2>
      <p class="hw-sub">The process</p>
    </div>
  </div>

  <div class="hw-stage" data-hw-stage>
    <svg class="hw-svg" viewBox={`0 0 ${STAGE_W} ${STAGE_H}`} preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="hwLineGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#ffcf85" /><stop offset="0.5" stop-color="#ff8a3a" /><stop offset="1" stop-color="#df5435" />
        </linearGradient>
        <filter id="hwLineGlow" x="-30%" y="-10%" width="160%" height="120%"><feGaussianBlur stdDeviation="3" /></filter>
      </defs>
      <path d={SNAKE_D} fill="none" stroke="rgba(255,140,60,0.12)" stroke-width="2" stroke-linecap="round" />
      <path data-hw-line-glow d={SNAKE_D} fill="none" stroke="url(#hwLineGrad)" stroke-width="10" stroke-linecap="round" opacity="0.35" filter="url(#hwLineGlow)" style="stroke-dasharray:3000;stroke-dashoffset:3000;" />
      <path data-hw-line d={SNAKE_D} fill="none" stroke="url(#hwLineGrad)" stroke-width="2.6" stroke-linecap="round" style="stroke-dasharray:3000;stroke-dashoffset:3000;" />
    </svg>
    {stops.map(s => (
      <span class="hw-ball" data-hw-ball data-threshold={s.threshold} style={`--x:${(s.x / STAGE_W) * 100}%;--y:${(s.y / STAGE_H) * 100}%;`} aria-hidden="true"></span>
    ))}

    <ol class="hw-stops">
      {stops.map(s => (
        <li class={`hw-stop hw-stop-${s.textSide}`} data-hw-stop data-threshold={s.threshold} style={`--x:${(s.x / STAGE_W) * 100}%;--y:${(s.y / STAGE_H) * 100}%;`}>
          <span class="hw-dot" aria-hidden="true"></span>
          <h3 class="hw-stop-title">{s.title}</h3>
          <p class="hw-stop-desc"><span>{s.l1}</span> <span>{s.l2}</span></p>
        </li>
      ))}
    </ol>

    <div class="hw-outro">
      <p>It's not complicated.</p>
      <p>It's just not random.</p>
      <p class="hw-outro-accent">Once the direction is clear, this is how we build.</p>
    </div>
  </div>
</section>

<style>
  .hw { position: relative; z-index: 1; padding: calc(var(--section) - 20px) var(--gutter) calc(var(--section) - 40px); overflow: hidden; }

  .hw-head { position: relative; z-index: 3; display: flex; justify-content: center; }
  .hw-group { position: relative; display: inline-flex; flex-direction: column; }
  .hw-sun, .hw-sun-halo { position: absolute; left: 50%; top: 38%; border-radius: 50%; pointer-events: none; }
  .hw-sun-halo { width: 440px; height: 440px; transform: translate(-45%, -50%); background: radial-gradient(circle, rgba(255,150,70,.14), rgba(255,150,70,.05) 45%, transparent 70%); }
  .hw-sun { width: 230px; height: 230px; transform: translate(-42%, -50%); background: #ff8a3a; box-shadow: 0 0 60px 12px rgba(255,140,60,.3), 0 0 180px 60px rgba(255,120,60,.12); }
  .hw-title { position: relative; margin: 0; font-family: 'Alumni', 'Madani', sans-serif; font-weight: 400; font-size: clamp(76px, 9.2vw, 132px); line-height: 1; letter-spacing: 2px; color: #fff; text-shadow: 0 4px 30px rgba(0,0,0,.6); }
  .hw-sub { position: relative; margin: 14px 0 0 6px; font-weight: 400; font-size: 20px; line-height: 1; letter-spacing: .3px; color: #d8cec3; }

  /* ── Snake stage (≥900) ── */
  .hw-stage { position: relative; z-index: 1; width: min(1200px, 100%); height: 1200px; margin: -40px auto 0; }
  .hw-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  [data-hw-line], [data-hw-line-glow] { transition: stroke-dashoffset .12s linear; }
  .hw-ball { position: absolute; left: var(--x); top: var(--y); width: 16px; height: 16px; margin: -8px 0 0 -8px; border-radius: 50%; background: #ff8a3a; pointer-events: none; transition: box-shadow .5s ease; }
  .hw-ball.is-lit { box-shadow: 0 0 16px 6px rgba(255,138,58,.55); }

  .hw-stops { list-style: none; margin: 0; padding: 0; }
  .hw-stop { position: absolute; left: var(--x); top: var(--y); width: 300px; }
  .hw-stop-right { transform: translate(32px, -50%); text-align: left; }
  .hw-stop-left  { transform: translate(calc(-100% - 32px), -50%); text-align: right; max-width: calc(var(--x) + var(--gutter) - 40px); }
  .hw-dot { display: none; }
  .hw-stop-title {
    margin: 0 0 12px; font-family: 'Alumni', 'Madani', sans-serif; font-weight: 400;
    font-size: clamp(54px, 4.4vw, 64px); line-height: 1; letter-spacing: 1px;
    color: rgba(255,255,255,.35); text-shadow: 0 2px 18px rgba(0,0,0,.55);
    transition: color .45s ease, text-shadow .55s ease;
  }
  .hw-stop.is-lit .hw-stop-title { color: #fff; text-shadow: 0 0 24px rgba(255,140,60,.5), 0 2px 18px rgba(0,0,0,.55); }
  .hw-stop-desc { margin: 0; font-weight: 400; font-size: 16px; line-height: 1.55; color: #8f857c; transition: color .35s ease; }
  .hw-stop-desc span:first-child { display: block; }
  .hw-stop.is-lit .hw-stop-desc { color: #c9c0b6; }

  .hw-outro { position: absolute; right: 0; bottom: 0; max-width: 340px; text-align: right; font-weight: 500; font-size: 15px; line-height: 1.6; color: #8a7a70; }
  .hw-outro p { margin: 0; }
  .hw-outro .hw-outro-accent { margin-top: 12px; color: #d07a40; }

  /* 900–1199: smaller stage, descriptions flow as one sentence */
  @media (max-width: 1199px) {
    .hw-sun-halo { width: 380px; height: 380px; }
    .hw-sun { width: 190px; height: 190px; }
    .hw-stage { width: min(840px, 100%); height: 950px; margin-top: -30px; }
    .hw-stop { width: 220px; }
    .hw-stop-desc span:first-child { display: inline; }
  }

  /* <900: vertical timeline */
  @media (max-width: 899px) {
    .hw-head { justify-content: flex-start; }
    .hw-sun-halo { display: none; }
    .hw-sun { left: 170px; top: -14px; width: 160px; height: 160px; transform: none; box-shadow: 0 0 40px 8px rgba(255,140,60,.3), 0 0 120px 40px rgba(255,120,60,.12); }
    .hw-title { font-size: 104px; letter-spacing: 1px; }
    .hw-stage { width: auto; height: auto; margin: 72px 0 0; }
    .hw-svg, .hw-ball { display: none; }
    .hw-stops { position: relative; max-width: 560px; padding-left: 48px; }
    .hw-stops::before {
      content: ""; position: absolute; left: 7px; top: 10px; bottom: 40px; width: 2px; border-radius: 2px;
      background: linear-gradient(180deg, #ffcf85, #ff8a3a 50%, #df5435); box-shadow: 0 0 10px rgba(255,138,58,.5);
    }
    .hw-stop, .hw-stop-left, .hw-stop-right { position: relative; left: auto; top: auto; width: auto; max-width: none; transform: none; text-align: left; padding-bottom: 40px; }
    .hw-dot {
      display: block; position: absolute; left: -48px; top: 14px; width: 16px; height: 16px; border-radius: 50%;
      background: #5a3a2a; transition: background .4s ease, box-shadow .4s ease;
    }
    .hw-stop.is-lit .hw-dot { background: #ff8a3a; box-shadow: 0 0 0 5px rgba(255,138,58,.18), 0 0 20px rgba(255,138,58,.7); }
    .hw-stop-title { font-size: 56px; margin-bottom: 8px; }
    .hw-outro { position: static; max-width: none; text-align: left; margin-top: 8px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,.07); }
  }
  @media (max-width: 599px) {
    .hw-sun { left: 120px; top: -10px; width: 120px; height: 120px; }
    .hw-title { font-size: 76px; }
    .hw-sub { font-size: 17px; margin-top: 10px; }
    .hw-stage { margin-top: 56px; }
    .hw-stops { padding-left: 36px; }
    .hw-dot { left: -36px; top: 12px; }
    .hw-stop-title { font-size: 46px; }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('[data-hw-stage]');
  const line  = document.querySelector<SVGPathElement>('[data-hw-line]');
  const glow  = document.querySelector<SVGPathElement>('[data-hw-line-glow]');
  const stops = Array.from(document.querySelectorAll<HTMLElement>('[data-hw-stop]'));
  const balls = Array.from(document.querySelectorAll<HTMLElement>('[data-hw-ball]'));
  const timeline = () => window.matchMedia('(max-width: 899px)').matches;

  if (stage && line) {
    let total = 0;
    const initLength = () => {
      total = line.getTotalLength();
      for (const p of [line, glow]) if (p) { p.style.strokeDasharray = String(total); p.style.strokeDashoffset = String(total); }
    };
    const clamp01 = (v: number) => v < 0 ? 0 : v > 1 ? 1 : v;

    const update = () => {
      const vh = window.innerHeight || document.documentElement.clientHeight;
      if (timeline()) {
        // Each stop lights when it crosses 70% of the viewport.
        for (const s of stops) s.classList.toggle('is-lit', s.getBoundingClientRect().top < vh * 0.7);
        return;
      }
      const r = stage.getBoundingClientRect();
      const startTop = vh * 0.75, endBot = vh * 0.35;
      const p = clamp01((startTop - r.top) / ((startTop - endBot) + r.height));
      const off = String(total * (1 - p));
      line.style.strokeDashoffset = off;
      if (glow) glow.style.strokeDashoffset = off;
      for (const s of stops) s.classList.toggle('is-lit', p >= parseFloat(s.dataset.threshold || '1'));
      for (const b of balls) b.classList.toggle('is-lit', p >= parseFloat(b.dataset.threshold || '1'));
    };

    initLength();
    window.addEventListener('load', () => { initLength(); update(); });
    window.addEventListener('resize', () => { initLength(); update(); });
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (ticking) return; ticking = true;
      requestAnimationFrame(() => { ticking = false; update(); });
    }, { passive: true });
    update();
  }
</script>
