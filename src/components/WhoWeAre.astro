---
---
<section id="who" class="who">
  <div class="container who-grid">
    <div class="reveal who-text">
      <h2 class="h2 who-title">Who We Are</h2>
      <div class="who-body">
        <p class="who-lead">Ora is a creative and strategy-driven team.</p>
        <p>We work with brands that are done with random content and want something that actually makes sense.</p>
        <p>Sometimes that means building from scratch.<br />Sometimes it means fixing what's already there.</p>
        <p>We've worked with brands across industries building content that doesn't just look good, but performs.</p>
      </div>
    </div>
    <div class="reveal who-showcase">
      <img src="/images/who-showcase.webp" alt="The epicenter of digital evolution" loading="lazy" width="1920" height="1080" decoding="async" />
    </div>
  </div>
</section>

<style>
  .who { position: relative; z-index: 1; padding: var(--section) 0 calc(var(--section) - 20px); }
  .who-grid { display: grid; grid-template-columns: 5fr 7fr; gap: 80px; align-items: center; }
  .who-title { margin-bottom: 36px; }
  .who-body { display: flex; flex-direction: column; gap: 18px; font-weight: 400; font-size: 20px; line-height: 1.7; color: var(--body); text-wrap: pretty; }
  .who-body p { margin: 0; }
  .who-lead { color: var(--text); font-weight: 500; }
  .who-showcase {
    aspect-ratio: 16 / 10; border-radius: 20px; overflow: hidden;
  }
  .who-showcase img { width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 1199px) { .who-grid { gap: 48px; } .who-body { font-size: 18px; } }
  @media (max-width: 899px) {
    .who-grid { grid-template-columns: 1fr; gap: 40px; }
    .who-body { max-width: 640px; }
  }
  @media (max-width: 599px) {
    .who-title { margin-bottom: 24px; }
    .who-body { gap: 14px; font-size: 17px; line-height: 1.65; }
    /* Image bleeds off the right edge on phones */
    .who-showcase { aspect-ratio: 4 / 3; margin-right: calc(var(--gutter) * -1); border-radius: 16px 0 0 16px; border-right: 0; box-shadow: 0 30px 60px rgba(0,0,0,.55); }
  }
</style>
