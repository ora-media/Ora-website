---
// 18 tiles in a 6-col grid, aspect 3/4, with the mouse acting as a flashlight
// cutting through the dark vignette that covers the grid. Real photos are
// pulled from /images/work/ so the section reads like a portfolio wall.

// 18 tiles, in numerical order 1.webp → 18.webp.
const tiles = Array.from({ length: 18 }, (_, i) => ({
  id: `work-${i + 1}`,
  src: `/images/work/${i + 1}.webp`,
}));
---
<section id="work" class="work">
  <div class="work-inner">
    <!-- Watermark title above the grid — each word styled independently
         to give the "Not" prominence, "Just" a smaller/distant feel, and
         "Content" a subtle left-tilt. -->
    <h2 class="work-title" aria-label="Not Just Content">
      <span class="wt-not">Not</span>
      <span class="wt-just">Just</span>
      <span class="wt-content">Content</span>
    </h2>

    <div class="work-grid">
      {tiles.map(t => (
        <button class="work-tile" data-id={t.id} data-src={t.src} type="button" aria-label="Expand image">
          <img src={t.src} alt="" loading="lazy" />
        </button>
      ))}
    </div>
  </div>

  <!-- Full-width overlays — cover the whole viewport width, not the container. -->
  <div aria-hidden="true" class="work-vignette"></div>
  <div class="work-flash" aria-hidden="true"></div>
</section>

<!-- Lightbox — full-screen enlarged image, click backdrop or Esc to close. -->
<div class="work-lightbox" data-work-lightbox hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Enlarged image">
  <button class="work-lightbox-close" data-work-lightbox-close aria-label="Close">&times;</button>
  <button class="work-lightbox-nav prev" data-work-lightbox-prev aria-label="Previous">&#8249;</button>
  <img class="work-lightbox-img" data-work-lightbox-img alt="" />
  <button class="work-lightbox-nav next" data-work-lightbox-next aria-label="Next">&#8250;</button>
</div>

<style>
  .work {
    position: relative; z-index: 1;
    padding: 130px 0 140px;
    overflow: hidden;
    background: transparent;             /* lets the site's gradient show through */
  }

  /* Watermark title — each word gets its own scale, opacity, and blur so
     the phrase reads as an out-of-focus tagline hovering above the grid.
     "Not" dominates, "Just" recedes, "Content" tilts slightly to the left. */
  .work-title {
    font-family: 'Madani', sans-serif;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -2px;
    margin: 0 0 40px;
    text-align: center;
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: clamp(10px, 2vw, 30px);
    font-size: clamp(40px, 6vw, 88px);
    /* fallback colour for browsers that ignore per-span overrides */
    color: rgba(240, 220, 200, 0.14);
  }
  /* Blur applied on the parent so every word gets the SAME out-of-focus weight. */
  .work-title { filter: blur(1.5px); }
  .work-title span { display: inline-block; }
  .wt-not {
    font-size: 1.25em;
    color: rgba(240, 220, 200, 0.18);
    letter-spacing: -3px;
  }
  .wt-just {
    font-size: 0.5em;
    color: rgba(240, 220, 200, 0.11);
    letter-spacing: 0;
    transform: translateY(-6%);      /* nudge up so it aligns with cap-height */
  }
  .wt-content {
    font-size: 1.1em;
    color: rgba(240, 220, 200, 0.16);
    letter-spacing: -2px;
    /* 3D perspective tilt — the right edge recedes into the page (leans
       "inwards" rather than tilting downwards on a flat 2D axis). */
    transform: perspective(600px) rotateY(-28deg);
    transform-origin: center;
  }

  .work-inner {
    position: relative;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 44px;
    z-index: 1;
  }
  .work-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 14px;
  }
  .work-tile {
    aspect-ratio: 3 / 4;
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    box-shadow: 0 6px 20px rgba(0,0,0,0.4);
    /* Reset button defaults */
    appearance: none;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    color: inherit;
  }
  .work-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Dim the images so the whole grid reads like the reference — dark
       portfolio wall with the flashlight cursor exposing the details. */
    filter: brightness(0.72) saturate(0.85);
    transition: filter .35s ease, transform .5s ease;
  }
  .work-tile:hover img {
    filter: brightness(1) saturate(1);
    transform: scale(1.03);
  }

  /* Soft vignette — covers the FULL viewport width of the section and
     extends BEYOND the section top/bottom so the fade blends smoothly into
     whatever section sits above/below (no hard "box of shadow" edge). */
  .work-vignette {
    position: absolute;
    top: -180px; bottom: -180px; left: 0; right: 0;
    pointer-events: none;
    background: radial-gradient(ellipse 65% 55% at 50% 50%,
      transparent 40%,
      rgba(0,0,0,0.5) 78%,
      rgba(0,0,0,0.9) 100%);
    z-index: 2;
    /* Long, gentle fades on both top and bottom so the vignette gradually
       fades into the neighbouring sections rather than cutting off sharply. */
    -webkit-mask-image: linear-gradient(180deg,
      transparent 0%,
      rgba(0,0,0,0.3) 10%,
      #000 28%,
      #000 72%,
      rgba(0,0,0,0.3) 90%,
      transparent 100%);
    mask-image: linear-gradient(180deg,
      transparent 0%,
      rgba(0,0,0,0.3) 10%,
      #000 28%,
      #000 72%,
      rgba(0,0,0,0.3) 90%,
      transparent 100%);
  }

  /* Flashlight — a bright hole in a black scrim that follows the cursor. */
  .work-flash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
    background: radial-gradient(circle 460px at var(--fx, 50%) var(--fy, 50%),
      rgba(0,0,0,0)    0%,
      rgba(0,0,0,0.25) 45%,
      rgba(0,0,0,0.60) 82%,
      rgba(0,0,0,0.80) 100%);
    -webkit-mask-image:
      linear-gradient(180deg, transparent, #000 12%, #000 88%, transparent),
      linear-gradient(90deg,  transparent, #000 6%,  #000 94%, transparent);
    mask-image:
      linear-gradient(180deg, transparent, #000 12%, #000 88%, transparent),
      linear-gradient(90deg,  transparent, #000 6%,  #000 94%, transparent);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
    transition: opacity .3s ease;
  }

  @media (max-width: 900px) {
    .work-inner { padding: 0 20px; }
    .work-grid { grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .work-title { font-size: clamp(28px, 8vw, 44px); letter-spacing: -1px; margin-bottom: 24px; }
    /* Flashlight is a desktop-only affordance */
    .work-flash { display: none; }
    .work-tile img { filter: brightness(0.9) saturate(0.95); }
  }

  /* ── Lightbox ───────────────────────────────────────── */
  .work-lightbox {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(4, 3, 8, 0.92);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    padding: 40px;
    animation: wlbFade .28s ease both;
  }
  .work-lightbox[hidden] { display: none; }
  @keyframes wlbFade {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  .work-lightbox-img {
    max-width: min(92vw, 1400px);
    max-height: 88vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 16px;
    box-shadow: 0 40px 100px rgba(0,0,0,0.7);
    animation: wlbZoom .32s cubic-bezier(.2,.7,.2,1) both;
  }
  @keyframes wlbZoom {
    from { opacity: 0; transform: scale(0.94); }
    to   { opacity: 1; transform: scale(1); }
  }
  .work-lightbox-close,
  .work-lightbox-nav {
    position: absolute;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.15);
    color: #fff;
    cursor: pointer;
    border-radius: 50%;
    display: grid;
    place-items: center;
    transition: background .2s ease, transform .2s ease, border-color .2s ease;
    font-family: sans-serif;
  }
  .work-lightbox-close:hover,
  .work-lightbox-nav:hover {
    background: rgba(255,255,255,0.16);
    border-color: rgba(255,255,255,0.3);
    transform: scale(1.05);
  }
  .work-lightbox-close {
    top: 20px; right: 20px;
    width: 44px; height: 44px;
    font-size: 26px; line-height: 1;
  }
  .work-lightbox-nav {
    top: 50%; transform: translateY(-50%);
    width: 52px; height: 52px;
    font-size: 30px; line-height: 1;
  }
  .work-lightbox-nav.prev { left: 20px; }
  .work-lightbox-nav.next { right: 20px; }
  .work-lightbox-nav:hover { transform: translateY(-50%) scale(1.05); }
  @media (max-width: 700px) {
    .work-lightbox { padding: 12px; }
    .work-lightbox-close { width: 38px; height: 38px; font-size: 22px; }
    .work-lightbox-nav { width: 42px; height: 42px; font-size: 24px; }
    .work-lightbox-nav.prev { left: 10px; }
    .work-lightbox-nav.next { right: 10px; }
  }
</style>

<script>
  const work = document.getElementById('work');
  const flash = work?.querySelector<HTMLElement>('.work-flash');
  if (work && flash) {
    // Fade the flashlight scrim in only when the cursor is over the section.
    // When the cursor leaves, the plain vignette takes over so nothing looks
    // "stuck" bright in one spot.
    let over = false;
    work.addEventListener('mouseenter', () => { over = true; flash.style.opacity = '1'; });
    work.addEventListener('mouseleave', () => { over = false; flash.style.opacity = '0'; });
    flash.style.opacity = '0';
    work.addEventListener('mousemove', (e: MouseEvent) => {
      if (!over) return;
      const r = work.getBoundingClientRect();
      flash.style.setProperty('--fx', `${e.clientX - r.left}px`);
      flash.style.setProperty('--fy', `${e.clientY - r.top}px`);
    }, { passive: true });
  }

  /* ── Lightbox — click a tile to enlarge, prev/next to cycle. ── */
  const lb      = document.querySelector<HTMLElement>('[data-work-lightbox]');
  const lbImg   = document.querySelector<HTMLImageElement>('[data-work-lightbox-img]');
  const lbClose = document.querySelector<HTMLElement>('[data-work-lightbox-close]');
  const lbPrev  = document.querySelector<HTMLElement>('[data-work-lightbox-prev]');
  const lbNext  = document.querySelector<HTMLElement>('[data-work-lightbox-next]');
  const workTiles = Array.from(document.querySelectorAll<HTMLElement>('.work-tile'));
  const workSrcs  = workTiles.map(t => t.dataset.src || (t.querySelector('img')?.src ?? ''));

  let lbIndex = -1;
  const showAt = (i: number) => {
    if (!lb || !lbImg || workSrcs.length === 0) return;
    lbIndex = (i + workSrcs.length) % workSrcs.length;
    lbImg.src = workSrcs[lbIndex];
    // Retrigger the zoom animation each time we swap the src
    lbImg.style.animation = 'none';
    void lbImg.offsetWidth;
    lbImg.style.animation = '';
  };
  const openAt = (i: number) => {
    if (!lb) return;
    showAt(i);
    lb.hidden = false;
    lb.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  };
  const closeLb = () => {
    if (!lb) return;
    lb.hidden = true;
    lb.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    lbIndex = -1;
  };

  workTiles.forEach((tile, i) => {
    tile.addEventListener('click', () => openAt(i));
  });
  lbClose?.addEventListener('click', closeLb);
  lb?.addEventListener('click', (e) => { if (e.target === lb) closeLb(); });
  lbPrev?.addEventListener('click', (e) => { e.stopPropagation(); showAt(lbIndex - 1); });
  lbNext?.addEventListener('click', (e) => { e.stopPropagation(); showAt(lbIndex + 1); });
  document.addEventListener('keydown', (e) => {
    if (!lb || lb.hidden) return;
    if (e.key === 'Escape') closeLb();
    else if (e.key === 'ArrowLeft')  showAt(lbIndex - 1);
    else if (e.key === 'ArrowRight') showAt(lbIndex + 1);
  });
</script>
