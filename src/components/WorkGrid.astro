---
// 18 tiles, hover-only (no full-view). A smoothed flashlight follows the
// cursor on devices with a fine pointer.
const tiles = Array.from({ length: 18 }, (_, i) => `/images/work/${i + 1}.webp`);
---
<section id="work" class="work" data-work>
  <div class="container work-inner">
    <h2 class="work-title" aria-label="Not Just Content">
      <span class="wt-not">Not</span>
      <span class="wt-just">Just</span>
      <span class="wt-content">Content</span>
    </h2>
    <div class="work-grid">
      {tiles.map(src => (
        <div class="work-tile"><img src={src} alt="" loading="lazy" decoding="async" draggable="false" /></div>
      ))}
    </div>
  </div>
  <div class="work-flash" aria-hidden="true" data-flash></div>
  <div class="work-glow" aria-hidden="true" data-glow></div>
</section>

<style>
  .work { position: relative; z-index: 1; padding: calc(var(--section) - 20px) 0 var(--section); }
  .work-inner { position: relative; z-index: 1; }

  .work-title {
    margin: 0 0 48px;
    display: flex; align-items: baseline; justify-content: center; gap: clamp(10px, 2vw, 28px);
    font-weight: 900; font-size: clamp(40px, 6.1vw, 88px); line-height: 1; letter-spacing: -2px;
    filter: blur(1.5px); white-space: nowrap; user-select: none; pointer-events: none;
  }
  .work-title span { display: inline-block; }
  .wt-not { font-size: 1.25em; color: rgba(240,220,200,.18); letter-spacing: -3px; }
  .wt-just { font-size: .5em; color: rgba(240,220,200,.11); letter-spacing: 0; }
  .wt-content { font-size: 1.1em; color: rgba(240,220,200,.16); transform: perspective(600px) rotateY(-28deg); }

  .work-grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 12px; }
  .work-tile {
    aspect-ratio: 3 / 4; border-radius: 14px; overflow: hidden;
    border: 1px solid rgba(255,255,255,.08);
    box-shadow: 0 10px 28px rgba(0,0,0,.45);
    filter: brightness(.78) saturate(.88);
    transition: filter .35s ease, transform .45s var(--ease), box-shadow .35s ease;
  }
  .work-tile img { width: 100%; height: 100%; object-fit: cover; user-select: none; -webkit-user-drag: none; }

  /* Flashlight scrim (ink-coloured, edge-faded so it never boxes the section) */
  .work-flash {
    position: absolute; inset: -120px 0; z-index: 2; pointer-events: none; opacity: 0;
    transition: opacity .6s ease;
    background: radial-gradient(circle 380px at var(--fx, 50%) var(--fy, 50%),
      rgba(5,3,8,0) 0%, rgba(5,3,8,.08) 35%, rgba(5,3,8,.55) 70%, rgba(5,3,8,.82) 100%);
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 18%, #000 82%, transparent), linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    -webkit-mask-composite: source-in;
            mask-image: linear-gradient(180deg, transparent, #000 18%, #000 82%, transparent), linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
            mask-composite: intersect;
  }
  /* Warm core of the light */
  .work-glow {
    position: absolute; inset: 0; z-index: 2; pointer-events: none; opacity: 0;
    transition: opacity .6s ease; mix-blend-mode: screen;
    background: radial-gradient(circle 260px at var(--fx, 50%) var(--fy, 50%), rgba(255,147,23,.16), rgba(223,84,53,.07) 45%, transparent 70%);
  }
  .work.is-lit .work-flash, .work.is-lit .work-glow { opacity: 1; }

  @media (hover: hover) and (pointer: fine) {
    .work-tile:hover { filter: brightness(1) saturate(1); transform: translateY(-4px); box-shadow: 0 18px 40px rgba(0,0,0,.55); }
  }
  @media (hover: none) {
    .work-flash, .work-glow { display: none; }
    .work-tile { filter: brightness(.92) saturate(.95); }
  }

  @media (max-width: 899px) {
    .work-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
    .work-title { margin-bottom: 36px; letter-spacing: -1.5px; }
  }
  @media (max-width: 599px) {
    .work-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
    .work-tile { border-radius: 10px; box-shadow: 0 6px 16px rgba(0,0,0,.4); }
    .work-title { margin-bottom: 28px; filter: blur(1px); letter-spacing: -1px; }
  }
</style>

<script>
  const work  = document.querySelector<HTMLElement>('[data-work]');
  const flash = document.querySelector<HTMLElement>('[data-flash]');
  const glow  = document.querySelector<HTMLElement>('[data-glow]');
  if (work && flash && glow && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const f = { x: 0, y: 0, tx: 0, ty: 0, raf: 0 };
    const paint = () => {
      f.x += (f.tx - f.x) * 0.14;
      f.y += (f.ty - f.y) * 0.14;
      flash.style.setProperty('--fx', `${f.x}px`); flash.style.setProperty('--fy', `${f.y + 120}px`);
      glow.style.setProperty('--fx', `${f.x}px`);  glow.style.setProperty('--fy', `${f.y}px`);
      f.raf = Math.abs(f.tx - f.x) + Math.abs(f.ty - f.y) > 0.3 ? requestAnimationFrame(paint) : 0;
    };
    const pos = (e: MouseEvent) => { const r = work.getBoundingClientRect(); return [e.clientX - r.left, e.clientY - r.top]; };
    work.addEventListener('mouseenter', e => { [f.x, f.y] = [f.tx, f.ty] = pos(e); paint(); work.classList.add('is-lit'); });
    work.addEventListener('mouseleave', () => work.classList.remove('is-lit'));
    work.addEventListener('mousemove', e => { [f.tx, f.ty] = pos(e); if (!f.raf) f.raf = requestAnimationFrame(paint); }, { passive: true });
  }
</script>
