---
const services = [
  { id: 'content', num: '01', label: 'Content & Production', subtitle: 'We create content that reflects the brand — not just fills the feed.', icon: '/images/services/content-production.webp',
    bullets: ['Brand-led photography & videography', 'Creative direction & concept development', 'Campaign production & shoots', 'Short-form & social-first video content', 'Visual storytelling & art direction', 'Post-production, editing & color grading'] },
  { id: 'strategy', num: '02', label: 'Strategy & Social Media', subtitle: 'We bring structure to content — so it actually means something.', icon: '/images/services/strategy-social.webp',
    bullets: ['Content strategy & planning', 'Social media management', 'Brand positioning & messaging', 'Monthly content calendars', 'Captioning & storytelling', 'Performance review & optimization'] },
  { id: 'growth', num: '03', label: 'Growth & Performance', subtitle: 'We focus on turning attention into measurable results.', icon: '/images/services/growth-performance.webp',
    bullets: ['Paid media strategy & execution', 'Campaign setup & optimization', 'Audience targeting & segmentation', 'Creative testing & iterations', 'Funnel thinking & conversion tracking', 'Performance reporting & insights'] },
  { id: 'ai', num: '04', label: 'Digital & AI Solutions', subtitle: 'Content needs a system behind it. We build what supports the brand beyond the surface.', icon: '/images/services/digital-ai.webp',
    bullets: ['Website & digital platform development', 'AI chatbots & automation systems', 'Landing pages for campaigns', 'CRM & system integrations', 'Custom-built digital solutions'] },
];
---
<section id="do" class="wwd">
  <div class="container">
    <div class="reveal wwd-head">
      <h2 class="h2">What We Do</h2>
      <p class="wwd-lead">We don't offer disconnected services —<br />we build systems that help brands grow.</p>
    </div>

    <div class="reveal wwd-tabs" role="tablist" aria-label="Services">
      {services.map((s, i) => (
        <button class={`wwd-tab ${i === 0 ? 'is-active' : ''}`} role="tab" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} data-service={s.id} aria-selected={i === 0 ? 'true' : 'false'}>
          <span class="wwd-tab-num">{s.num}</span>
          <span class="wwd-tab-label">{s.label}</span>
        </button>
      ))}
    </div>

    <div class="wwd-panels reveal">
      {services.map((s, i) => (
        <article class="wwd-panel" id={`panel-${s.id}`} data-panel={s.id} role="tabpanel" aria-labelledby={`tab-${s.id}`} hidden={i !== 0}>
          <div class="wwd-panel-text">
            <h3 class="wwd-panel-title">{s.label}</h3>
            <p class="wwd-panel-sub">{s.subtitle}</p>
            <ul class="wwd-panel-list">{s.bullets.map(b => <li>{b}</li>)}</ul>
          </div>
          <div class="wwd-panel-visual" aria-hidden="true">
            <div class="wwd-num-wrap">
              <div class="wwd-big-num">{s.num}</div>
              <img class="wwd-icon" src={s.icon} alt="" loading="lazy" />
            </div>
          </div>
        </article>
      ))}
    </div>

    <p class="reveal wwd-closing">Every part of the work is connected — and that's where the real impact happens.</p>
  </div>
</section>

<style>
  .wwd { position: relative; z-index: 1; padding: var(--section) 0; }
  .wwd-head { display: grid; grid-template-columns: 5fr 7fr; gap: 80px; align-items: end; }
  .wwd-lead { margin: 0; max-width: 620px; font-weight: 400; font-size: 22px; line-height: 1.6; color: #b8b0a7; }

  /* Tabs */
  .wwd-tabs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 88px; }
  .wwd-tab {
    appearance: none; cursor: pointer; text-align: left; font-family: inherit;
    display: flex; flex-direction: column; align-items: flex-start; gap: 18px;
    padding: 28px 28px 24px; border-radius: 20px;
    background: rgba(255,255,255,.02); border: 1px solid rgba(255,255,255,.07);
    transition: background .35s ease, border-color .35s ease, box-shadow .35s ease, transform .3s var(--ease);
  }
  .wwd-tab:hover { transform: translateY(-3px); border-color: rgba(255,147,23,.35); }
  .wwd-tab:active { transform: scale(.98); }
  .wwd-tab:focus-visible { outline: 2px solid var(--orange); outline-offset: 3px; }
  .wwd-tab-num {
    padding: 0 4px; font-family: 'Alumni', sans-serif; font-size: 104px; line-height: 1.05;
    background: linear-gradient(180deg, rgba(240,149,90,.55), rgba(122,52,24,.45));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .wwd-tab-label { font-weight: 700; font-size: 18px; line-height: 1.25; color: #a89f96; transition: color .3s ease; }
  .wwd-tab.is-active {
    background: linear-gradient(180deg, rgba(255,138,58,.10), rgba(255,255,255,.02));
    border-color: rgba(255,147,23,.45);
    box-shadow: 0 0 40px rgba(255,120,40,.18), inset 0 1px 0 rgba(255,255,255,.08);
  }
  .wwd-tab.is-active .wwd-tab-num { background-image: linear-gradient(180deg, #ffb066, #c25a26); }
  .wwd-tab.is-active .wwd-tab-label { color: #fff; }

  /* Panel */
  .wwd-panels { margin-top: 72px; }
  .wwd-panel { display: grid; grid-template-columns: 6fr 5fr; gap: 60px; align-items: center; min-height: 480px; animation: wwdFade .5s ease both; }
  .wwd-panel[hidden] { display: none; }
  @keyframes wwdFade { from { opacity: 0; transform: translateY(12px); filter: blur(3px); } to { opacity: 1; transform: none; filter: none; } }
  .wwd-panel-title { margin: 0 0 18px; font-weight: 900; font-size: 56px; line-height: 1.02; letter-spacing: -1.5px; color: #fff; }
  .wwd-panel-sub { margin: 0 0 36px; max-width: 540px; font-weight: 400; font-size: 20px; line-height: 1.55; color: #b8b0a7; text-wrap: pretty; }
  .wwd-panel-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0 32px; }
  .wwd-panel-list li {
    position: relative; padding: 16px 0 16px 20px; border-top: 1px solid rgba(255,255,255,.08);
    font-weight: 600; font-size: 17px; line-height: 1.4; color: #efe8dc;
  }
  .wwd-panel-list li::before { content: ""; position: absolute; left: 0; top: calc(16px + .6em); width: 6px; height: 6px; border-radius: 50%; background: var(--orange); transform: translateY(-50%); }

  .wwd-panel-visual { position: relative; height: 480px; display: flex; align-items: center; justify-content: center; }
  .wwd-panel-visual::before {
    content: ""; position: absolute; left: 5%; right: -10%; bottom: -40px; height: 60%;
    background: radial-gradient(ellipse 70% 100% at 60% 30%, rgba(255,90,50,.35), rgba(220,60,30,.18) 25%, rgba(180,40,20,.08) 55%, transparent 85%);
    filter: blur(24px); pointer-events: none;
  }
  .wwd-num-wrap { position: relative; }
  .wwd-big-num {
    padding: 0 10px; font-family: 'Alumni', sans-serif; font-size: 420px; line-height: 1; letter-spacing: -6px;
    background: linear-gradient(180deg, #ff8a3a, #7a2e10); -webkit-background-clip: text; background-clip: text; color: transparent;
    filter: drop-shadow(0 0 80px rgba(255,120,50,.35)); user-select: none;
  }
  /* Icon floats at the number's top-right corner */
  .wwd-icon {
    position: absolute; top: -30px; right: -90px; width: 210px; height: 210px; object-fit: contain;
    filter: drop-shadow(0 25px 45px rgba(0,0,0,.55));
    animation: bob 7s ease-in-out infinite;
  }

  .wwd-closing { margin: 100px 0 0; max-width: 900px; font-weight: 700; font-size: clamp(26px, 2.8vw, 40px); line-height: 1.2; letter-spacing: -.5px; color: var(--ember); text-wrap: pretty; }

  /* 900–1199 */
  @media (max-width: 1199px) {
    .wwd-head { gap: 48px; }
    .wwd-tab-num { font-size: 84px; }
    .wwd-panel { gap: 32px; min-height: 420px; }
    .wwd-panel-title { font-size: 44px; }
    .wwd-panel-list { grid-template-columns: 1fr; }
    .wwd-panel-visual { height: 400px; }
    .wwd-big-num { font-size: 300px; }
    .wwd-icon { top: -20px; right: -50px; width: 160px; height: 160px; }
    .wwd-closing { margin-top: 80px; }
  }
  /* 600–899 */
  @media (max-width: 899px) {
    .wwd-head { grid-template-columns: 1fr; gap: 20px; }
    .wwd-tabs { grid-template-columns: repeat(2, 1fr); gap: 10px; margin-top: 56px; }
    .wwd-tab-num { font-size: 76px; }
    .wwd-panels { margin-top: 48px; }
    .wwd-panel { grid-template-columns: 1fr; gap: 24px; min-height: 0; }
    .wwd-panel-visual { order: -1; height: 360px; }
    .wwd-panel-title { font-size: 42px; }
    .wwd-panel-list { grid-template-columns: 1fr 1fr; }
    .wwd-icon { top: -10px; right: -80px; width: 150px; height: 150px; }
    .wwd-closing { margin-top: 72px; }
  }
  /* <600 */
  @media (max-width: 599px) {
    .wwd-lead { font-size: 17px; }
    .wwd-lead br { display: none; }
    .wwd-tabs { gap: 8px; margin-top: 40px; }
    .wwd-tab { gap: 10px; min-height: 120px; padding: 16px; border-radius: 16px; }
    .wwd-tab-num { font-size: 56px; padding: 0 2px; }
    .wwd-tab-label { font-size: 14px; }
    .wwd-panels { margin-top: 36px; }
    .wwd-panel {
      gap: 0; padding: 28px 20px 24px; border-radius: 20px; overflow: hidden;
      background: linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,.01));
      border: 1px solid rgba(255,255,255,.08);
    }
    .wwd-panel-visual { height: auto; margin: 8px 0 24px; }
    .wwd-panel-visual::before { display: none; }
    .wwd-big-num { font-size: 170px; letter-spacing: -2px; padding: 0 6px; filter: drop-shadow(0 0 30px rgba(255,120,50,.3)); }
    .wwd-icon { top: -14px; right: -56px; width: 104px; height: 104px; animation-duration: 6s; }
    .wwd-panel-title { font-size: 30px; letter-spacing: -.8px; margin-bottom: 12px; }
    .wwd-panel-sub { font-size: 16px; margin-bottom: 20px; }
    .wwd-panel-list { grid-template-columns: 1fr; }
    .wwd-panel-list li { padding: 13px 0 13px 18px; font-size: 15px; }
    .wwd-panel-list li::before { top: calc(13px + .6em); }
    .wwd-closing { margin-top: 56px; }
  }
</style>

<script>
  const tabs   = Array.from(document.querySelectorAll<HTMLButtonElement>('#do [data-service]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('#do [data-panel]'));
  const select = (btn: HTMLButtonElement) => {
    const id = btn.dataset.service!;
    for (const b of tabs) { const on = b === btn; b.classList.toggle('is-active', on); b.setAttribute('aria-selected', String(on)); b.tabIndex = on ? 0 : -1; }
    for (const p of panels) p.hidden = p.dataset.panel !== id;
  };
  tabs.forEach((btn, i) => {
    btn.tabIndex = i === 0 ? 0 : -1;
    btn.addEventListener('click', () => select(btn));
    btn.addEventListener('keydown', e => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!d) return;
      e.preventDefault();
      const next = tabs[(i + d + tabs.length) % tabs.length];
      next.focus(); select(next);
    });
  });
</script>
